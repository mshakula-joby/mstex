% rbd-support.sty
%
% Support macros for RAL/bare-metal design presentations: a Jira ticket glossary.
%
%   \setjirabaseurl{<base>}
%       Sets the base of the Jira ticket URLs once, e.g. https://jira.example.com/browse/ (the ticket id is
%       appended).
%   \setgithubpullbaseurl{<base>}
%       Sets the base of the GitHub pull request URLs once, e.g. https://git.example.com/Org/Repo/pull/ (the pull
%       request number is appended).
%   \addjirainfo[<pull request numbers>]{<id>}{<description>}
%       Adds <id> to the "Jira Tickets" glossary with its description. The Jira URL is the Jira base URL followed
%       by the id; each pull request number, one or several separated by commas, becomes a GitHub URL the same way.
%   \gls{<id>}, \acrshort{<id>}, \acrlong{<id>}, \acrfull{<id>}
%       The tickets are acronyms of the Jira glossary: the id is the short form and the title the long form.
%       \gls writes the id in monospace, with the title in parentheses on first use ("id (title)"), and then just
%       the id. The acronym commands do no formatting: \acrshort is the plain id, \acrlong the title and \acrfull
%       "id (title)". Other acronyms of the document are not affected. The glossary lists the tickets that were
%       cited.
%   \printjiraglossary
%       Prints the Jira glossary as a table of id, description and links (breakable across frames). Only the
%       tickets that the document refers to, with \gls or the acronym commands, are listed.
%
% The glossary is of type "jira" (files .jlg, .jgs, .jgo; run makeglossaries, which latexmk can do with a
% custom dependency). Load this package after the theme.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rbd-support}[2026/10/17 Jira ticket glossary for design presentations]

\RequirePackage{hyperref}
\RequirePackage{xparse}
\RequirePackage{etoolbox}
\@ifpackageloaded{glossaries}{}{\RequirePackage[nonumberlist]{glossaries}}

\newglossary[jlg]{jira}{jgs}{jgo}{Jira Tickets}
\makeglossaries
% \gls is the one command that formats a ticket: the id in monospace, and on first use "id (title)" with the
% title in the normal font. \acrfull of a ticket also reads "id (title)", plain. Other acronyms of the document
% keep the acronym style they have; only the tickets (entries of the Jira glossary) are affected.
% (At the start of the document: glossaries sets the default acronym style then, and that would replace it.)
\AtBeginDocument{%
	\let\jirasupportorigacrfullformat\genacrfullformat
	\renewcommand*{\genacrfullformat}[2]{%
		\edef\jirasupportentrytype{\glsentrytype{#1}}%
		\ifdefstring{\jirasupportentrytype}{jira}%
			{\glsentryshort{#1}\glsspace(\glsentrylong{#1})#2}%
			{\jirasupportorigacrfullformat{#1}{#2}}%
	}%
}
\defglsentryfmt[jira]{%
	\ifdefempty{\glscustomtext}{%
		\ifglsused{\glslabel}%
			{\texttt{\glsentryshort{\glslabel}}}%
			{\texttt{\glsentryshort{\glslabel}} (\glsentrylong{\glslabel})}%
	}{\glscustomtext}% \acrshort, \acrlong and \acrfull give their own text: no formatting
	\glsinsert
}

% --- The glossary entry ----------------------------------------------------------------------------------
% The base URLs are used when the glossary is printed, so they can be set anywhere before it.
\newcommand{\jirasupportjirabase}{}
\newcommand{\jirasupportgithubbase}{}
\NewDocumentCommand{\setjirabaseurl}{ m }{\renewcommand{\jirasupportjirabase}{#1}}
\NewDocumentCommand{\setgithubpullbaseurl}{ m }{\renewcommand{\jirasupportgithubbase}{#1}}

% The ticket is an acronym of the Jira glossary: the id is the short form and the title the long form, both
% plain, so \acrshort, \acrlong and \acrfull print them without formatting.
% The entry keeps the ticket id in user1 and the (optional) pull request numbers in user2.
% The sort key is the id with its number zero-padded, so tickets sort by number (S4TC-999 before S4TC-10000)
% instead of character by character.
\ExplSyntaxOn
\seq_new:N \l__jirasupport_parts_seq
\tl_new:N \l__jirasupport_sort_tl
\cs_new_protected:Npn \__jirasupport_set_sort:n #1
  {
    \regex_extract_once:nnNTF { \A (.*-) (\d+) \Z } {#1} \l__jirasupport_parts_seq
      {
        \tl_set:Nx \l__jirasupport_sort_tl
          {
            \seq_item:Nn \l__jirasupport_parts_seq {2}
            \prg_replicate:nn { 12 - \str_count:e { \seq_item:Nn \l__jirasupport_parts_seq {3} } } { 0 }
            \seq_item:Nn \l__jirasupport_parts_seq {3}
          }
      }
      { \tl_set:Nn \l__jirasupport_sort_tl {#1} }
  }
\tl_new:N \l__jirasupport_prs_tl
\cs_new_protected:Npn \__jirasupport_new:nnnn #1 #2 #3 #4
  {
    \newacronym [ type = jira , sort = {#1} , user1 = {#2} , user2 = {#3} ] {#2} {#2} {#4}
  }
\cs_generate_variant:Nn \__jirasupport_new:nnnn { VnVn }
\NewDocumentCommand{\addjirainfo}{ o m m }
  {
    \__jirasupport_set_sort:n {#2}
    \IfNoValueTF {#1}
      { \tl_clear:N \l__jirasupport_prs_tl }
      { \tl_set:Nn \l__jirasupport_prs_tl {#1} }
    \__jirasupport_new:VnVn \l__jirasupport_sort_tl {#2} \l__jirasupport_prs_tl {#3}
  }
\ExplSyntaxOff

% --- The glossary table ----------------------------------------------------------------------------------
% One row per ticket: id, description, and the Jira and GitHub links. Rows are paragraphs, so the table can
% break across frames (a tabular could not).
% One "GitHub:" line for each URL in the comma-separated list.
\newcommand{\jirasupportgithubline}[1]{\\GitHub: \edef\jirasupportpullurl{\jirasupportgithubbase#1}\href{\jirasupportpullurl}{\expandafter\nolinkurl\expandafter{\jirasupportpullurl}}}
% Code names in a ticket title (\texttt{CInputSignalManagementTelemetryBase}) are one long word with no place to
% break, which overflows the narrow description column. In the table, \texttt may break such a name where a lower
% case letter or digit is followed by a capital, and after \_ or ::, without a hyphen (which would change the name).
\ExplSyntaxOn
\tl_new:N \l__jirasupport_tt_tl
\cs_new_protected:Npn \jirasupportbreakabletexttt #1
  {
    \tl_set:Nn \l__jirasupport_tt_tl {#1}
    \regex_replace_all:nnN { ([a-z0-9])([A-Z]) } { \1 \c{allowbreak} \2 } \l__jirasupport_tt_tl
    \regex_replace_all:nnN { (\c{_}|_|::) } { \1 \c{allowbreak} } \l__jirasupport_tt_tl
    { \ttfamily \tl_use:N \l__jirasupport_tt_tl }
  }
\ExplSyntaxOff

\newglossarystyle{jiratable}{%
	\renewenvironment{theglossary}{\par\small}{\par}%
	\renewcommand*{\glossaryheader}{%
		\noindent\parbox[t]{0.14\linewidth}{\textbf{Ticket}}\hfill
		\parbox[t]{0.36\linewidth}{\raggedright\textbf{Description}}\hfill
		\parbox[t]{0.46\linewidth}{\raggedright\textbf{Links}}\par\medskip}%
	\renewcommand*{\glossentry}[2]{%
		\edef\jirasupporturl{\jirasupportjirabase\glsentryuseri{##1}}%
		\edef\jirasupportgithub{\glsentryuserii{##1}}%
		\noindent\parbox[t]{0.14\linewidth}{\texttt{\glsentryshort{##1}}}\hfill
		\parbox[t]{0.36\linewidth}{\raggedright\let\texttt\jirasupportbreakabletexttt\glsentrylong{##1}}\hfill
		\parbox[t]{0.46\linewidth}{\raggedright\scriptsize
			Jira: \href{\jirasupporturl}{\expandafter\nolinkurl\expandafter{\jirasupporturl}}%
			\ifdefempty{\jirasupportgithub}{}{\expandafter\forcsvlist\expandafter{\expandafter\jirasupportgithubline\expandafter}\expandafter{\jirasupportgithub}}%
		}\par\smallskip}%
	\providecommand*{\glossarysubgroupheading}[1]{}%
	\renewcommand*{\glsgroupskip}{}%
}

\NewDocumentCommand{\printjiraglossary}{}{%
	\printglossary[type=jira, style=jiratable, title={}]%
}

\endinput
