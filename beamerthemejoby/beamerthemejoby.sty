% beamerthemejoby.sty
%
% Beamer theme for Joby presentations: the Gotham theme recolored with the Joby brand palette
% (https://brand.jobyaviation.com/graphic-elements), Joby Sans fonts and the Joby logo mark.
%
% Usage:
%   \documentclass[aspectratio=169,10pt]{beamer}
%   \usetheme[palette=osaka]{joby}
%
% Options:
%   palette=<name>   color pair from section 8.3 of the brand guide's color page:
%                    blue (default; also default or light), orange, green, navy, osaka. Add -dark for
%                    the dark variant (osaka-dark, ...); dark alone is blue-dark. Dark variants use a
%                    more muted version of the primary color for title bars and standout slides.
%   fontsize=<size>  scales every font size so that the normal text is <size>, e.g. fontsize=6pt (Beamer's
%                    own sizes stop at 8pt: the 8pt and 9pt options already use the extsizes package, and
%                    sizes it does not know, such as 6pt, silently fall back to 11pt). Give the class a base
%                    size close to the one you want, e.g. \documentclass[8pt]{beamer}.
%   proprietary      marks the deck as proprietary: adds a notice to the footer and a notice slide
%                    after the title page.
%   legal            adds Joby's legal disclaimer (legal-disclaimer.tex in this directory) as standin
%                    slides, as many as the text needs, after the proprietary notice and before the outline.
%
% The institute defaults to \institute{Joby Aviation}; set your own \institute to override it.
%
% This directory must be on TEXINPUTS (the project's .latexmkrc does this). Joby Sans is loaded from
% fonts/ and the logo source is kept as jobymark.svg here. Needs LuaLaTeX; other engines fall back to
% Gotham's fonts with a warning.
%
% Package integration (applied only if the package is loaded, whether before or after the theme):
%   hyperref        - \href and \url links use the palette's emphasis (alert) color.
%   revision-number - the revision (\makerevision) is printed small in the title page's bottom right corner.
%   listings        - code blocks use the palette's accent color as their background.
%   cleveref        - \cref links work (Beamer disables them) and cover the whole name, "Figure 1".
%                   Load cleveref after the theme. A \label in a frame names the slide as the footer
%                   shows it (\ref gives "5", \cref gives "slide 5", front matter slides "slide ii").
%   glossaries      - a glossary prints without its own section heading (the frame title is the heading).
%                   Number lists show physical PDF pages, so load glossaries with nonumberlist.
%
% Appendix (after \appendix):
%   sections are lettered (A, B, ...) and left out of the outline. Appendix slides use the standin frame
%   style by default; an explicit frame style ([standout], [plain], ...) overrides it. The slide numbers
%   keep counting (appendixnumberbeamer's restart at 1 is undone). Beamer's "Part I: Appendix" page is
%   dropped. Use one \section per part, with a frame that holds \printbibliography[heading=none]
%   (biblatex; use allowframebreaks), \listoffigures or \listoftables, or \printglossaries.
%
% Lists of figures and tables:
%   Beamer ignores \listoffigures and \listoftables; here they print each caption with the slide number
%   it appears on (the same number as in the footer).
%
% Text: \emph is redefined as \alert (Joby Sans has no italic); \textbf, \texttt and \alert work as usual.
% Joby Sans is a rebranded Universal Sans without italics or small caps, so Fira Sans (Gotham's font)
% supplies \textit and \scshape/\textsc when it is installed; without it italics are slanted Joby Sans.
%
% Slides and numbering:
%   Title page      - title, author, institute and date, centered in that order, with the Joby mark in Joby
%                     Blue below. Not numbered.
%   Notice slide    - with the proprietary option, a centered notice right after the title page.
%   Legal slides    - with the legal option, the legal disclaimer follows it, split over standin slides.
%   Outline         - [toc] frames list sections with the number of each heading slide.
%   Heading slides  - section, subsection (part, subsubsection) pages are numbered like any other slide.
%   Front matter    - the notice slide and the outline are numbered i, ii, ... and not counted, so the
%                     arabic numbers start at 1 on the first heading slide.
%
% Footer (every slide with a footer):
%   left   - copyright, the institute in capitals (the author if \institute is empty) and the compile
%            date as MM/DD/YYYY; very small (3.5pt) and faint.
%   middle - the short title, centered on the page.
%   right  - with the proprietary option, "PROPRIETARY INFORMATION. DO NOT DISTRIBUTE." (very small and
%            faint), then the slide number.
%
% Frame styles, set with \begin{frame}[<style>]{...}:
%   (default)       title bar in the palette color with the white Joby mark, then the footer.
%   standout        full-bleed palette-color slide; small title at the top left, large text in the background color (Gotham's behavior).
%   standin         no title bar; dark title at the top left on the normal background.
%   toc             the styled outline, with slide numbers; counts as front matter.
%   jobyfront       front matter: footer number is a lowercase roman numeral and is not counted.
%   plain           Beamer's plain, redefined: a thin accent-color bar along the top edge, for slides
%                   without a title bar; the footer stays. [empty] is Beamer's original plain: it
%                   drops the footer (the title bar stays); the title page uses it. Heading slides and the notice
%                   slide have the accent bar already; it replaces a [watermark] since both use the
%                   background template.
%   noframenumbering  the slide does not advance the slide count (Beamer).
%   nofooter        removes the footer text but keeps the slide number.
%   nofootline      removes the whole footer line.
%   nopagenumber    removes the slide number.
%   edging, noedging  Gotham's side edgings; empty unless you define \gothamLeftFiligrane or
%                   \gothamRightFiligrane.
%   watermark, nowatermark  Gotham's background watermark (define the template, see the Gotham manual).
%   noBGC           removes the background canvas.
%   nologo          removes Beamer's \logo; the mark in the title bar stays.
%   c, t, b         vertical alignment of the content (Beamer).
%   fragile, allowframebreaks, shrink   as in Beamer (use fragile for lstlisting).
% Frame styles from Gotham not listed here (e.g. rotateFooter) work as documented there.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemejoby}[2026/10/16 Joby Gotham-based Beamer theme]

\ExplSyntaxOn
\tl_new:N \g_joby_palette_tl
\tl_new:N \g_joby_fontsize_tl
\tl_gset:Nn \g_joby_palette_tl { blue }
\bool_new:N \g_joby_proprietary_bool
\bool_new:N \g_joby_legal_bool
\keys_define:nn { joby }
  {
    palette .tl_gset:N = \g_joby_palette_tl ,
    fontsize .tl_gset:N = \g_joby_fontsize_tl ,
    proprietary .bool_gset:N = \g_joby_proprietary_bool ,
    proprietary .default:n = { true } ,
    legal .bool_gset:N = \g_joby_legal_bool ,
    legal .default:n = { true } ,
  }
\ExplSyntaxOff
\ProcessKeyOptions[joby]

% Load the base theme first.
% See https://ctan.org/tex-archive/macros/latex/contrib/beamer-contrib/themes/beamertheme-gotham?lang=en
% Heading pages (section, subsection) are numbered like any other slide, so that the table of contents
% can cite the number shown on them. Gotham only provides these options if they are not defined yet.
\newcommand{\partpageOptions}{}
\newcommand{\sectionpageOptions}{}
\newcommand{\subsectionpageOptions}{}
\newcommand{\subsubsectionpageOptions}{}

\usetheme{gotham}

% Loaded with \RequirePackage: \usecolortheme/\useoutertheme here make LuaTeX fail at PDF output with a
% font-embedding error ("cannot find file ''") once Joby Sans is loaded.
\RequirePackage{beamercolorthemejoby}
\RequirePackage{beamerfontthemejoby}
\RequirePackage{beamerinnerthemejoby}
\RequirePackage{beamerouterthemejoby}

% Joby Sans has no italic, so \emph (which would fake one) is the same as \alert: the palette's emphasis color.
\DeclareRobustCommand{\emph}[1]{\alert{#1}}

% Joby Sans has deeper descenders than Fira, which Gotham's tiny footline depth clips at the page edge.
\setlength{\gothamFootlineDepth}{1.2ex}

\ExplSyntaxOn
\bool_if:NTF \g_joby_dark_bool
  {
    \gothamset { background = dark }
    % Gotham's dark mode makes the title bars and standout slides light; use the palette's muted primary color.
    % (Gotham applies its dark colors late, so this runs at the start of the document.)
    \AtBeginDocument
      {
        \colorlet { colorFrametitle } { colorAmuted }
        \colorlet { colorStandout } { colorAmuted }
        \setbeamercolor { frametitle } { fg = JobyWhite }
      }
  }
  { \gothamset { background = light } }
\ExplSyntaxOff
\gothamset{
	numbering=framenumber,
	parttocframe default=off,
	sectiontocframe default=off,
	subsectiontocframe default=off,
}

% Run <code> now if <package> is already loaded, or right after it is loaded later.
\newcommand{\jobywithpackage}[2]{%
	\@ifpackageloaded{#1}{#2}{\AddToHook{package/#1/after}{#2}}%
}

\setbeamertemplate{frame footer}[joby]
\institute{Joby Aviation}

\jobywithpackage{hyperref}{%
	% Internal links (outline, section titles, footer) keep their normal color.
	\hypersetup{colorlinks=true, urlcolor=colorD, linkcolor={}, citecolor={}, filecolor=colorD}%
}

\jobywithpackage{revision-number}{%
	\renewcommand{\jobytitlerevision}{\makerevision}%
}

\jobywithpackage{glossaries}{%
	% The frame title is the heading, so a glossary prints without its own section heading.
	\renewcommand*{\glossarysection}[2][]{}%
}

% cleveref: Beamer loads hyperref with implicit=false, which makes cleveref switch its hyperref support
% off, so \cref produces no links at all. Load cleveref after the theme and the links work (hide the
% option from cleveref while it loads), with the whole name in the link ("Figure 1", not just "1").
\makeatletter
\@ifpackageloaded{cleveref}{%
	\PackageWarning{beamerthemejoby}{cleveref was loaded before the theme, so its links stay disabled; load cleveref after \string\usetheme}%
}{%
	\PassOptionsToPackage{nameinlink}{cleveref}%
	\AddToHook{package/cleveref/before}{%
		\expandafter\let\expandafter\jobysavedopthyperref\csname opt@hyperref.sty\endcsname
		\expandafter\def\csname opt@hyperref.sty\endcsname{}%
	}%
	\AddToHook{package/cleveref/after}{%
		\expandafter\let\csname opt@hyperref.sty\endcsname\jobysavedopthyperref
		\jobycleverefslides
	}%
}

% A \label inside a frame names the slide, shown the way the footer shows it: \ref prints its number and
% (with cleveref) \cref prints "slide 5". Beamer sets \@currentlabel from the frame number at the start of
% every frame (\refcounter{framenumber}); the front matter slides, which are numbered with roman numerals,
% replace that with their numeral. cleveref keeps its own record of the label, taken from \@currentcounter
% (the counter last stepped, which would be the section), so that is set as well.
\newif\ifjobyinfront
\newcommand{\jobyslidelabel}[2]{%
	\protected@edef\@currentlabel{#2}%
	\def\@currentcounter{#1}%
	\ifdefined\cref@currentlabel
		\protected@edef\cref@currentlabel{[framenumber][#2][]#2}%
	\fi
}
\let\jobyrefcounter@orig\refcounter
\def\refcounter#1{%
	\jobyrefcounter@orig{#1}%
	\def\@tempa{#1}\def\@tempb{framenumber}%
	\ifx\@tempa\@tempb
		\ifjobyinfront
			\jobyslidelabel{}{\romannumeral\jobyfrontbase}%
		\else
			\jobyslidelabel{framenumber}{\arabic{framenumber}}%
		\fi
	\fi
}
\newcommand{\jobycleverefslides}{%
	\crefname{framenumber}{slide}{slides}%
	\Crefname{framenumber}{Slide}{Slides}%
}

\jobywithpackage{listings}{%
	\lstset{
		% On the code background, in the slide's text color (light on the dark variants), framed by a hairline in
		% the accent color.
		basicstyle=\ttfamily\scriptsize\usebeamercolor[fg]{normal text},
		backgroundcolor=\color{code background},
		frame=single,
		framerule=0.3pt,
		rulecolor=\color{colorAccent},
		framexleftmargin=1ex,
		framexrightmargin=1ex,
		framextopmargin=1ex,
		framexbottommargin=1ex,
		xleftmargin=1ex,
		xrightmargin=1ex,
		breaklines=true,
		showstringspaces=false,
		columns=fullflexible,
		keepspaces=true,
	}%
	% listings sets its captions itself, not through Beamer's caption templates, so give them Beamer's caption font.
	\let\jobyorig@lstmakecaption\lst@makecaption
	\long\def\lst@makecaption#1#2{{\usebeamerfont{caption}\jobyorig@lstmakecaption{#1}{#2}}}%
}

\endinput
