% beamerouterthemejoby.sty
%
% Joby logo mark and its placement: white in the frame title bars, Joby Blue on the title page.
% Requires the Gotham theme.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerouterthemejoby}[2026/10/16 Joby logo mark for Beamer]

\RequirePackage{tikz}

% Joby logo mark: \jobymark[<height>]{<color>}.
% Path converted from "Joby Logo Mark - Joby Blue.svg" (viewBox 357.35 x 224.47, kept next to this file as jobymark.svg) to TikZ coordinates,
% so it can be recolored to follow the palette.
\newcommand{\jobymarkpath}{%
	(120.70,122.14)%
	.. controls (93.14,200.31) and (60.05,216.44) .. (42.44,221.44)%
	.. controls (-24.15,240.35) and (-18.68,123.67) .. (104.23,98.57)%
	.. controls (165.29,-73.20) and (279.86,6.64) .. (341.67,132.39)%
	.. controls (376.94,204.13) and (348.81,243.25) .. (296.22,215.50)%
	.. controls (251.37,191.82) and (191.64,120.12) .. (120.70,122.14)%
	-- (120.70,122.14)%
	-- cycle%
	(46.48,155.41)%
	.. controls (18.25,189.82) and (59.25,231.38) .. (98.61,123.22)%
	.. controls (87.01,126.34) and (66.10,131.48) .. (46.48,155.41)%
	-- (46.48,155.41)%
	-- cycle%
	(128.34,97.78)%
	.. controls (212.52,101.02) and (278.96,191.26) .. (307.38,185.09)%
	.. controls (351.03,175.61) and (192.67,-94.66) .. (128.34,97.78)%
	-- (128.34,97.78)%
	-- cycle%
}
\NewDocumentCommand{\jobymark}{O{2.4ex} m}{%
	\resizebox{!}{#1}{%
		\begin{tikzpicture}
			\useasboundingbox (0,0) rectangle (357.35,224.47);
			\fill[#2] \jobymarkpath;
		\end{tikzpicture}%
	}%
}

% White mark at the right end of every frame title bar (Gotham's logo slot). Standin slides (including the
% appendix default) have no title bar, so there the mark would be a white mark on the slide background:
% invisible on the light variants, and visible on the dark ones. It is left out on standin slides.
\newif\ifjobyshowlogo
\jobyshowlogotrue
\renewcommand{\gothamInstituteLogoSquare}[1][3.2ex]{%
	\ifjobyshowlogo\raisebox{0.2ex}{\jobymark[#1]{JobyWhite}}\fi
}
\renewenvironment{standinenv}{\usebeamertemplate{standin}\jobyshowlogofalse}{}

% Mark on the title page (Gotham's title page logo slot).
% The 1.5pt xshift is an optical correction (the mark's long tail sits to the right of its loop).
% Anchored to the page rather than to Gotham's fixed picture offset, so it stays centered on any paper size.
% The revision string (\jobytitlerevision, set by beamerthemejoby when revision-number is loaded)
% goes in the bottom right corner, small and low-visibility.
\newcommand{\jobytitlerevision}{}
\renewcommand{\gothamtitlepagelogo}{%
	\begin{tikzpicture}[remember picture, overlay]
		\node at ([xshift=1.5pt, yshift=6ex]current page.south) {\jobymark[6ex]{JobyBlue}};
		\ifx\jobytitlerevision\@empty\else
			\node[anchor=south east, text=JobyDarkGray, font=\tiny]
				at ([xshift=-1.5ex, yshift=1.2ex]current page.south east) {\jobytitlerevision};
		\fi
	\end{tikzpicture}%
}

% Footer: copyright, institute and date (MM/DD/YYYY) at the bottom left (very small and faint), the short title centered on the
% page, and (with the proprietary option) the proprietary notice at the bottom right, before the slide
% number that Gotham's footline adds.
% The organization named in the footer and the proprietary notice: the institute, or the author if the
% document leaves the institute empty (\institute{}).
\RequirePackage{etoolbox}
\newcommand{\jobyorg}{\expandafter\ifblank\expandafter{\insertinstitute}{\insertauthor}{\insertinstitute}}
\newcommand{\jobyorgupper}{\expandafter\ifblank\expandafter{\insertinstitute}{\uppercase\expandafter{\insertauthor}}{\uppercase\expandafter{\insertinstitute}}}

\newcommand{\jobyfooterdate}{\two@digits{\month}/\two@digits{\day}/\the\year}
\newcommand{\jobyproprietaryfooter}{}
\ExplSyntaxOn
\bool_if:NT \g_joby_proprietary_bool
  { \renewcommand{\jobyproprietaryfooter}{PROPRIETARY~INFORMATION.~DO~NOT~DISTRIBUTE.} }
\ExplSyntaxOff

\defbeamertemplate{frame footer}{joby}{
	\hspace{\gothamLeftFooterPadding}%
	% Zero-width boxes, so the title is centered on the page whatever the left and right texts are.
	\hbox to 0pt{\kern\dimexpr\textwidth/2-3ex-\gothamLeftFooterPadding\relax
		\hbox to 0pt{\hss\insertshorttitle\gotham@strut\hss}\hss}%
	{\fontsize{3.5pt}{4pt}\selectfont\color{JobyDarkGray}\textcopyright~\jobyorgupper~\jobyfooterdate}%
	\hfill
	{\fontsize{3.5pt}{4pt}\selectfont\color{JobyDarkGray}\jobyproprietaryfooter}%
	\vspace*{\gothamFooterHOffset}
}

% Standout slides have a colored background, so the footer title is reversed (the frame title already is).
\addtobeamertemplate{standout}{\setbeamercolor{footline}{fg=JobyWhite}}{}

% allowframebreaks: the continuation numbering "(i)", "(ii)" is only shown when the frame really is broken
% into more than one slide (Beamer records the first and last slide of every frame in the .nav file).
\expandafter\let\csname beamer@@tmpop@frametitle continuation@default/gotham\endcsname\@undefined
\defbeamertemplate{frametitle continuation}{default/gotham}{%
	\ifnum\numexpr\beamer@endpageofframe+1-\beamer@startpageofframe\relax>1
		\usebeamerfont{frametitle}{(\romannumeral \insertcontinuationcount)}%
	\fi
}
\setbeamertemplate{frametitle continuation}[default/gotham]

% The institute is shown in the footer, so keep it off the title page.
\defbeamertemplate{institute}{joby}{}
\setbeamertemplate{institute}[joby]

% A thin bar in the accent color along the top of the "plain" slides, the ones without a title bar:
% the heading slides (part, section, subsection, subsubsection) and the proprietary notice slide.
\defbeamertemplate{background}{joby bar}{%
	\begin{tikzpicture}[remember picture, overlay]
		\fill[colorAccent] (current page.north west) rectangle ([yshift=-1.2mm]current page.north east);
	\end{tikzpicture}%
}
\newenvironment{jobybarenv}{\setbeamertemplate{background}[joby bar]}{}
% Beamer's [plain] frame option is redefined as the accent bar style: no title bar is needed, and the thin
% accent bar runs along the top edge. Beamer's own plain behavior (which drops the footer) is kept under
% the name [empty], which the title page uses so that it has no footer.
\ExplSyntaxOn
\cs_new_eq:NN \jobyorigplainkey \KV@beamerframe@plain
\define@key{beamerframe}{empty}[true]{ \jobyorigplainkey{#1} }
\define@key{beamerframe}{plain}[true]{
  \begin{jobybarenv}
  \seq_put_left:Nn \l__gotham_frameoption_tmp_seq { \end{jobybarenv} }
}
\ExplSyntaxOff
\def\maketitle{%
	\ifbeamer@inframe
		\titlepage
	\else
		\frame[empty, c, noframenumbering]{\titlepage}%
	\fi
}
\addtobeamertemplate{part frame}{\setbeamertemplate{background}[joby bar]}{}
\addtobeamertemplate{section frame}{\setbeamertemplate{background}[joby bar]}{}
\addtobeamertemplate{subsection frame}{\setbeamertemplate{background}[joby bar]}{}
\addtobeamertemplate{subsubsection frame}{\setbeamertemplate{background}[joby bar]}{}

% The proprietary notice slide, shown right after the title page. It has no title, so no header banner.
% It names the institute (default Joby Aviation), or the author if the institute is empty.
\newcommand{\jobyproprietaryslide}{%
	\begin{frame}[jobyfront, plain, c]
		\centering
		\large
		All information contained in these slides is \jobyorg\ Proprietary.\par
		\vspace{\baselineskip}
		Do not distribute without prior authorization from \jobyorg.\par
	\end{frame}%
}
\ExplSyntaxOn
\AtBeginDocument
  {
    \bool_if:NT \g_joby_proprietary_bool
      {
        \apptocmd { \maketitle } { \jobyproprietaryslide } { }
          { \PackageWarning { beamerouterthemejoby } { Could~not~patch~\string\maketitle;~no~proprietary~slide } }
      }
  }
\ExplSyntaxOff

\endinput
