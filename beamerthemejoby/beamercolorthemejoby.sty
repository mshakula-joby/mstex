% beamercolorthemejoby.sty
%
% Joby brand colors for Beamer on top of the Gotham color slots.
% Normally loaded by \usetheme[palette=<name>]{joby}; used on its own it picks the default palette.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemejoby}[2026/10/16 Joby brand colors for Beamer]

\ExplSyntaxOn
\tl_if_exist:NF \g_joby_palette_tl
  {
    \tl_new:N \g_joby_palette_tl
    \tl_gset:Nn \g_joby_palette_tl { blue }
  }
\ExplSyntaxOff

% Joby brand palette.
\definecolor{JobyBlack}{HTML}{0E1620}
\definecolor{JobyOffBlack}{HTML}{0E1620}
\definecolor{JobyWhite}{HTML}{F5F4ED}
\definecolor{JobyOffWhite}{HTML}{F5F4DF}
\definecolor{JobyGray}{HTML}{CDD0D1}
\definecolor{JobyDarkGray}{HTML}{A8ACAD}

\definecolor{JobyBlue}{HTML}{007AE5}
\definecolor{JobyDarkBlue}{HTML}{1C3F99}
\definecolor{JobyDarkBlueUI}{HTML}{083E6F}
\definecolor{JobyLightBlue}{HTML}{7CC3FF}
\definecolor{JobyLightestBlue}{HTML}{C1DFEF}

\definecolor{JobyYellow}{HTML}{FFB300}
\definecolor{JobyLightYellow}{HTML}{FFCC54}
\definecolor{JobyLightestYellow}{HTML}{FFDF94}

\definecolor{JobyOrange}{HTML}{EB6110}
\definecolor{JobyBrightOrange}{HTML}{FF660D}  % primary of color pair 2
\definecolor{JobyDarkOrange}{HTML}{D04C00}
\definecolor{JobyLightOrange}{HTML}{FF9058}
\definecolor{JobyLightestOrange}{HTML}{FFD9C9}

\definecolor{JobyRed}{HTML}{E64839}
\definecolor{JobyDarkRed}{HTML}{992E2E}
\definecolor{JobyLightRed}{HTML}{EE6371}
\definecolor{JobyPink}{HTML}{FB9DA6}

\definecolor{JobyGreen}{HTML}{00994C}
\definecolor{JobyDarkGreen}{HTML}{006141}
\definecolor{JobyLightGreen}{HTML}{3EC26A}
\definecolor{JobyLightestGreen}{HTML}{73E573}

\definecolor{JobyPurple}{HTML}{883DF2}
\definecolor{JobyDarkPurple}{HTML}{491C8A}
\definecolor{JobyLightPurple}{HTML}{B580FF}
\definecolor{JobyLightestPurple}{HTML}{D2B2FF}

% Constant Gotham slots.
\colorlet{colorPale}{JobyWhite}            % background
\colorlet{colorDark}{JobyOffBlack}         % foreground text
\colorlet{colorAreversed}{JobyWhite}       % text on colorA

% Color pairs from brand guide section 8.3. Each sets
% colorA (frame titles, standout slides), colorC (progress bar), colorD (alerts), colorE (examples),
% colorB (progress bar track, blocks; the pair's light color where it has one),
% colorAccent (the thin strip at the bottom of each pair: use it for frames and borders, e.g. draw=colorAccent),
% colorPale (the slide background: Joby White, or tinted with the pair's peach where it has one),
% colorAmuted (a more muted version of the primary color, used for title bars and standout slides in the
% dark variants).
\ExplSyntaxOn
\cs_new_protected:Nn \__joby_set_palette:nnnnnnnn
  {
    \colorlet { colorA } { #1 }
    \colorlet { colorC } { #2 }
    \colorlet { colorD } { #3 }
    \colorlet { colorE } { #4 }
    \colorlet { colorB } { #5 }
    \colorlet { colorAccent } { #6 }
    \colorlet { colorPale } { #7 }
    \colorlet { colorAmuted } { #8 }
  }
\msg_new:nnn { joby } { unknown-palette }
  { Unknown~palette~'#1'.~Use~blue~(also~default~or~light),~orange,~green,~navy~or~osaka,~each~optionally~with~-dark~(dark~alone~is~blue-dark). }
% A -dark suffix selects the dark variant of a palette; "dark" alone is blue-dark.
\bool_if_exist:NF \g_joby_dark_bool { \bool_new:N \g_joby_dark_bool }
\str_if_eq:VnT \g_joby_palette_tl { dark }
  { \tl_gset:Nn \g_joby_palette_tl { blue-dark } }
\str_if_eq:eeT { \tl_range:Nnn \g_joby_palette_tl { -5 } { -1 } } { -dark }
  {
    \bool_gset_true:N \g_joby_dark_bool
    \tl_gset:Nx \g_joby_palette_tl { \tl_range:Nnn \g_joby_palette_tl { 1 } { -6 } }
  }
% 'default' and 'light' are aliases for the default (blue) scheme.
\clist_if_in:nVT { default, light } \g_joby_palette_tl
  { \tl_gset:Nn \g_joby_palette_tl { blue } }
\str_case:VnF \g_joby_palette_tl
  {
    { blue }     { \__joby_set_palette:nnnnnnnn { JobyBlue }         { JobyDarkBlue } { JobyOrange } { JobyDarkBlue } { JobyDarkGray } { JobyLightestOrange } { JobyWhite } { JobyDarkBlueUI } }
    { orange }   { \__joby_set_palette:nnnnnnnn { JobyBrightOrange } { JobyDarkBlue } { JobyBlue }   { JobyDarkBlue } { JobyLightestOrange } { JobyYellow } { JobyLightestOrange!35!JobyWhite } { JobyDarkOrange } }
    { green }    { \__joby_set_palette:nnnnnnnn { JobyGreen }        { JobyDarkBlue } { JobyBlue }   { JobyDarkBlue } { JobyDarkGray } { JobyBlue } { JobyWhite } { JobyDarkGreen } }
    { navy }     { \__joby_set_palette:nnnnnnnn { JobyDarkBlue }     { JobyBlue }     { JobyRed }    { JobyBlue } { JobyLightestOrange } { JobyPink } { JobyLightestOrange!35!JobyWhite } { JobyDarkBlue } }
    { osaka }    { \__joby_set_palette:nnnnnnnn { JobyBlue }         { JobyDarkBlue } { JobyRed }    { JobyDarkBlue } { JobyLightestOrange } { JobyPink } { JobyLightestOrange!35!JobyWhite } { JobyDarkBlueUI } }
  }
  {
    \msg_error:nnV { joby } { unknown-palette } \g_joby_palette_tl
  }
% Dark variants: the same colors on an off-black background with Joby White text (Gotham's dark
% background swaps colorDark and colorPale, so the peach tint is dropped).
% The progress bar and title separator would be dark blue on dark blue, so they use Joby Blue.
\bool_if:NT \g_joby_dark_bool
  {
    \colorlet { colorPale } { JobyWhite }
    \colorlet { colorC } { JobyBlue }
  }
% colorAltBG, the alternate background, for areas set off from the slide (listings, inline code): Joby Off-White
% on the light variants, and on the dark ones the off-black background a step lighter, toward Joby White.
\bool_if:NTF \g_joby_dark_bool
  { \colorlet { colorAltBG } { JobyWhite!10!JobyOffBlack } }
  { \colorlet { colorAltBG } { JobyOffWhite } }
% The code background (listings, and \code of the common package): the alternate background with a quarter of
% its saturation, a step darker on the light variants and a step lighter on the dark ones; close to gray, but in
% its own hue.
\tl_new:N \l__joby_hsb_tl
\extractcolorspecs { colorAltBG } \l_tmpa_tl \l_tmpb_tl
\convertcolorspec \l_tmpa_tl \l_tmpb_tl { hsb } \l__joby_hsb_tl
\use:e
  {
    \exp_not:N \definecolor { code~background } { hsb }
      {
        \clist_item:Nn \l__joby_hsb_tl { 1 } ,
        \fp_eval:n { 0.25 * \clist_item:Nn \l__joby_hsb_tl { 2 } } ,
        \fp_eval:n
          { \bool_if:NTF \g_joby_dark_bool { 0.1 + 0.9 * } { 0.9 * } \clist_item:Nn \l__joby_hsb_tl { 3 } }
      }
  }
\ExplSyntaxOff
\gothamReloadColors
\endinput
