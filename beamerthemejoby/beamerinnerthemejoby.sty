% beamerinnerthemejoby.sty
%
% Slide numbers in the table of contents: each section and subsection entry gets the number of the
% slide it starts on, right-aligned. Requires the Gotham theme (its "bullet" and "simple" styles).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerinnerthemejoby}[2026/10/16 Slide numbers in the Beamer table of contents]

\RequirePackage{etoolbox}

% The number shown is the footer's number of the section's (or subsection's) heading slide, so it
% matches what the reader sees on that slide. If heading pages are turned off it is the first slide
% after the heading. Beamer's own anchors are physical pages and are not used. The numbers are recorded
% in the .aux file, so the first run shows none (latexmk reruns as needed).
\newcommand{\jobytocpage}[2]{\global\@namedef{jobytoc@#1}{#2}}
\newcommand{\jobytocbefore}{0}
\newcommand{\jobytocrecord}[1]{%
	\immediate\write\@auxout{\string\jobytocpage{#1}{%
		\number\numexpr\c@framenumber\ifnum\c@framenumber>\jobytocbefore\else+1\fi\relax}}%
}
\AtBeginDocument{%
	\pretocmd{\beamer@section}{\edef\jobytocbefore{\the\c@framenumber}}{}{%
		\PackageWarning{beamerinnerthemejoby}{Could not patch \string\beamer@section; no TOC slide numbers}}%
	\apptocmd{\beamer@section}{\jobytocrecord{sec:\thesection}}{}{}%
	\pretocmd{\beamer@subsection}{\edef\jobytocbefore{\the\c@framenumber}}{}{%
		\PackageWarning{beamerinnerthemejoby}{Could not patch \string\beamer@subsection; no TOC slide numbers}}%
	\apptocmd{\beamer@subsection}{\jobytocrecord{sub:\thesection.\thesubsection}}{}{}%
}

% Front matter slides (the proprietary notice and the outline) are not counted among the numbered
% slides: their footer shows a lowercase roman numeral (i, ii, ...) instead. They are marked with the
% frame option [jobyfront]; Gotham's [toc] option also runs it through tocenv.
\newcounter{jobyfrontframe}
% A frame that breaks over several slides (allowframebreaks) uses one numeral for each slide: the frame
% starts after the numerals already used, shows the next numeral on each of its slides, and when it ends the
% counter is advanced past all of them.
\newcount\jobyfrontnum
\newcount\jobyfrontlast
% The numeral of the slide being shipped out; it also remembers the last one used by the frame.
\newcommand{\jobyfrontshow}{%
	\jobyfrontnum=\numexpr\jobyfrontbase\ifnum\beamer@autobreakcount>1 +\beamer@autobreakcount-1\fi\relax
	\ifnum\jobyfrontnum>\jobyfrontlast\global\jobyfrontlast=\jobyfrontnum\fi
	\romannumeral\jobyfrontnum
}
\newenvironment{jobyfrontenv}{%
	\beamer@noframenumberingtrue
	\edef\jobyfrontbase{\the\numexpr\value{jobyfrontframe}+1\relax}%
	\global\jobyfrontlast=\value{jobyfrontframe}\relax
	\let\insertframenumber\jobyfrontshow
	% A \label in the slide names its roman numeral (see \refcounter in beamerthemejoby.sty).
	\jobyinfronttrue
	\jobyslidelabel{}{\romannumeral\jobyfrontbase}%
}{%
	\global\c@jobyfrontframe=\jobyfrontlast\relax
}
\ExplSyntaxOn
\__gotham_add_beamerframe_key:n { jobyfront }
\ExplSyntaxOff
\renewenvironment{tocenv}{%
	\usebeamertemplate{toc page}%
	\begin{jobyfrontenv}%
}{\end{jobyfrontenv}}

% Entries are set in an \hbox to the full line width, with the number flush right. (\hbox to rather than
% \makebox, whose own \hss would share the stretch with the \hfill that right-aligns the number.)
\newcommand{\jobytocwidth}{\linewidth}
\newcommand{\jobytocnumber}[1]{{\usebeamercolor[fg]{footer}\usebeamerfont{footnote}\@ifundefined{jobytoc@#1}{}{\csname jobytoc@#1\endcsname}}}

% Beamer refuses to redefine templates, so undefine Gotham's first.
\@for\jobytmp:={section in toc,subsection in toc,section in toc shaded,subsection in toc shaded}\do{%
	\@for\jobytmpstyle:={gotham bullet,gotham simple}\do{%
		\expandafter\let\csname beamer@@tmpop@\jobytmp @\jobytmpstyle\endcsname\@undefined
	}%
}

\defbeamertemplate{section in toc}{gotham bullet}{
	\leavevmode\hbox to \jobytocwidth{%
		\hspace*{0.4cm}\tikz[baseline=-0.5ex]\node[section number]{\textbf{\inserttocsectionnumber}};
		\ \tikz[baseline=-0.5ex]\node[section]{\usebeamerfont*{toc title}\inserttocsection};%
		\hfill\jobytocnumber{sec:\inserttocsectionnumber}%
	}\\[-0.35cm]
	\hspace*{1.13cm}{\usebeamercolor*[fg]{footer} \rule{0.69\linewidth}{0.2pt}{\par\vskip-0.35\baselineskip}\nointerlineskip}
}
\defbeamertemplate{subsection in toc}{gotham bullet}{
	\leavevmode\hbox to \jobytocwidth{%
		\hspace*{0.53cm}\tikz[baseline=-0.5ex]\node[subsection number]{};
		\hspace*{0.5cm}\tikz[baseline=-0.5ex]\node[subsection]{\usebeamerfont*{toc subtitle}\inserttocsubsection \gotham@strut};%
		\hfill\jobytocnumber{sub:\inserttocsectionnumber.\inserttocsubsectionnumber}%
	}
	\par \vspace{-0.38cm}
}
\defbeamertemplate{section in toc shaded}{gotham bullet}{
	\leavevmode\hbox to \jobytocwidth{%
		\hspace*{0.4cm}\tikz[baseline=-0.5ex]\node[section number, fill=colorBackElement!40]{\usebeamerfont*{toc subtitle}\textbf{\inserttocsectionnumber}};
		\ \tikz[baseline=-0.5ex]\node[section, text=colorBackElement!20]{\usebeamerfont*{toc title}\inserttocsection};%
		\hfill{\color{colorBackElement!20}\jobytocnumber{sec:\inserttocsectionnumber}}%
	}\\[-0.35cm]
	\hspace*{1.13cm}{\usebeamercolor*[fg]{footer} \rule{0.69\linewidth}{0.2pt}{\par\vskip-0.35\baselineskip}\nointerlineskip}
}
\defbeamertemplate{subsection in toc shaded}{gotham bullet}{
	\leavevmode\hbox to \jobytocwidth{%
		\hspace*{0.53cm}\tikz[baseline=-0.5ex]\node[subsection number,fill=colorBackElement!20]{};
		\hspace*{0.5cm}\tikz[baseline=-0.5ex]\node[subsection, text=colorBackElement!20]{\usebeamerfont*{toc subtitle}\inserttocsubsection \gotham@strut};%
		\hfill{\color{colorBackElement!20}\jobytocnumber{sub:\inserttocsectionnumber.\inserttocsubsectionnumber}}%
	}
	\par \vspace{-0.38cm}
}

\defbeamertemplate{section in toc}{gotham simple}{
	\leavevmode\hbox to \linewidth{{{\inserttocsectionnumber}.}~\inserttocsection\hfill\jobytocnumber{sec:\inserttocsectionnumber}}
	\par \vspace{-0.2cm}
}
\defbeamertemplate{subsection in toc}{gotham simple}{
	\leavevmode
	\hbox to \linewidth{\quad{{\inserttocsectionnumber}.\inserttocsubsectionnumber.}~\inserttocsubsection\hfill\jobytocnumber{sub:\inserttocsectionnumber.\inserttocsubsectionnumber}}
	\par \vspace{-0.2cm}
}
\defbeamertemplate{section in toc shaded}{gotham simple}{
	\leavevmode
	\begin{colormixin}{20!parent.bg}
		\hbox to \linewidth{{{\inserttocsectionnumber}.}~\inserttocsection\hfill\jobytocnumber{sec:\inserttocsectionnumber}}
	\end{colormixin}
	\par \vspace{-0.2cm}
}
\defbeamertemplate{subsection in toc shaded}{gotham simple}{
	\leavevmode
	\begin{colormixin}{20!parent.bg}
		\hbox to \linewidth{\quad{{\inserttocsectionnumber}.\inserttocsubsectionnumber.}~\inserttocsubsection\hfill\jobytocnumber{sub:\inserttocsectionnumber.\inserttocsubsectionnumber}}
	\end{colormixin}
	\par \vspace{-0.2cm}
}

% --- Appendix ----------------------------------------------------------------------------------------
% After \appendix: sections are lettered (A, B, ...), left out of the outline, and every slide uses the
% standin style (no title bar). Use \section for each appendix part, e.g. a bibliography, a list of
% figures or a glossary.
\newcommand{\jobytocappendix}{%
	% Read from the .toc file: drop every entry after this marker (local to the outline being typeset).
	\long\def\beamer@partintoc##1##2##3{}%
	\long\def\beamer@sectionintoc##1##2##3##4##5{}%
	\long\def\beamer@subsectionintoc##1##2##3##4##5##6{}%
}
\newif\ifjobyinappendix
% Appendix frames default to the standin style. The default is applied as a frame option that comes before
% the frame's own options, so an explicit frame style ([standout], [plain], ...) overrides it.
% The standin default sets the frame title's foreground explicitly, and setbeamercolor keeps keys that are
% not repeated, so the foreground is set again here (white in the dark variants).
\ExplSyntaxOn
\NewDocumentCommand{\jobyrestoreframetitlecolor}{}
  {
    \bool_if:NTF \g_joby_dark_bool
      { \setbeamercolor { frametitle } { use = primary~palette, parent = primary~palette, fg = JobyWhite, bg = colorFrametitle } }
      { \setbeamercolor { frametitle } { use = primary~palette, parent = primary~palette, fg = primary~palette.fg, bg = colorFrametitle } }
  }
\ExplSyntaxOff
\newcommand{\jobyappendixdefaults}{%
	\ifjobyinappendix\setkeys{beamerframe}{standin}\fi
}
\patchcmd{\beamer@@@@frame}
	{\setkeys{beamerframe}{environment=frame}}
	{\setkeys{beamerframe}{environment=frame}\jobyappendixdefaults}
	{}
	{\PackageWarning{beamerinnerthemejoby}{Could not patch \string\beamer@@@@frame; appendix frames keep their own style}}
% Gotham's standout style does not set the frame title colors that the default standin changed.
% In the dark variants Gotham's standout text (the title of a standout frame without a body) takes the
% off-black background color; it is Joby White instead.
\ExplSyntaxOn
\NewDocumentCommand{\jobyrestorestandouttext}{}
  {
    \bool_if:NT \g_joby_dark_bool
      {
        \setbeamercolor { primary~palette } { fg = JobyWhite }
        \usebeamercolor [ fg ] { primary~palette }
      }
  }
\ExplSyntaxOff
\renewenvironment{standoutenv}{\usebeamertemplate{standout}\jobyrestoreframetitlecolor\jobyrestorestandouttext}{}
\newcommand{\jobyappendixsetup}{%
	\setcounter{section}{0}\setcounter{subsection}{0}%
	\renewcommand{\thesection}{\Alph{section}}%
	\def\insertsectionnumber{\@Alph\c@section}%
	\addtocontents{toc}{\protect\jobytocappendix}%
	\global\jobyinappendixtrue
}
% appendixnumberbeamer restarts the slide numbers at 1 in the appendix; the numbering continues instead.
\newcommand{\jobyrestoreframenumber}[1]{\setcounter{framenumber}{#1}}
\AtBeginDocument{%
	\let\jobyorigappendix\appendix
	\renewcommand{\appendix}{%
		\jobyappendixsetup
		\edef\jobysavedframenumber{\the\c@framenumber}%
		% Beamer starts the appendix with a "Part I: Appendix" page; the lettered sections are enough.
		\let\jobyoldpart\part \let\part\@gobble
		\jobyorigappendix
		\let\part\jobyoldpart
		\jobyrestoreframenumber{\jobysavedframenumber}%
	}%
}

% --- Lists of figures and tables ---------------------------------------------------------------------
% Beamer ignores \listoffigures and \listoftables. Here each caption is recorded with its slide number
% and the lists print those, so they can be shown on a slide (best in the appendix).
\newcommand{\jobylistentry}[4]{%
	\noindent\hbox to \linewidth{\hbox to 5em{#1~#2\hss}#3\leaders\hbox{.}\hfill~#4}\par
}
% Beamer's \caption has already stepped the counter, so \the<type> is this caption's number. Captions of other
% types (a listing's) have no list here.
\let\jobyorigmakecaption\beamer@makecaption
\long\def\beamer@makecaption#1#2{%
	\ifcsname jobylistfile@#1\endcsname
		\addtocontents{\csname jobylistfile@#1\endcsname}{%
			\protect\jobylistentry{\csname #1name\endcsname}{\csname the#1\endcsname}{#2}{\insertframenumber}}%
	\fi
	\jobyorigmakecaption{#1}{#2}%
}
\@namedef{jobylistfile@figure}{lof}
\@namedef{jobylistfile@table}{lot}
\renewcommand{\listoffigures}{\@starttoc{lof}}
\renewcommand{\listoftables}{\@starttoc{lot}}

% --- Height of a frame's content ---------------------------------------------------------------------
% \jobyframeheight is the height available to the content of the current frame: the text height without the title
% banner and the footer. Beamer computes it (\beamer@frametextheight) only when the frame ends, so it is recorded
% in the .aux file and read back on the next pass; until then (the first run, or a frame the previous run did not
% have) it is \textheight-2\baselineskip. It expands to a dimension expression, so it fits pgfmath and \dimexpr:
% height={\jobyframeheight - 2cm}. Frames are counted as Beamer starts them, in the same order on every pass.
\newcounter{jobyframeid}
\newcommand{\jobyframeheightrecord}[2]{\global\@namedef{jobyframeh@#1}{#2}}
\newcommand{\jobyframeheight}{%
	\ifcsname jobyframeh@\the\c@jobyframeid\endcsname
		\csname jobyframeh@\the\c@jobyframeid\endcsname
	\else
		\textheight-2\baselineskip
	\fi
}
\newcommand{\jobyrecordframeheight}{%
	\protected@write\@auxout{}{\string\jobyframeheightrecord{\the\c@jobyframeid}{\the\beamer@frametextheight}}%
}
\pretocmd{\beamer@@@@frame}{\stepcounter{jobyframeid}}{}{%
	\PackageWarning{beamerinnerthemejoby}{Could not patch \string\beamer@@@@frame; \string\jobyframeheight is not available}}
\patchcmd{\endbeamer@frameslide}
	{\advance\beamer@frametextheight by-\beamer@frametopskip}
	{\advance\beamer@frametextheight by-\beamer@frametopskip\relax\jobyrecordframeheight}{}{%
	\PackageWarning{beamerinnerthemejoby}{Could not patch the end of a frame; \string\jobyframeheight is not available}}

\endinput
