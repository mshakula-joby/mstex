% common.sty
%
% Small helpers shared by the presentations.
%
%   \begin{fullpage}[<margin>] <content> \end{fullpage}
%       Puts a page in the PDF that is not a slide: its size is the size of the content plus <margin> (default 0pt)
%       on every side, whatever the slide size is, under a small "Attachment N" heading. It is shipped out
%       directly, so it has no title bar, footer or slide number and does not use up a slide number; Beamer does
%       not know about it (it is not in the outline or the navigation). Use it between frames, not inside one.
%       Needs LuaLaTeX. The content must not contain verbatim material.
%
%       Each page is an attachment: \label inside it works, and with cleveref, \cref{<label>} reads
%       "attachment N" and \Cref{<label>} "Attachment N" (load cleveref after the Beamer theme so that its
%       links work), and \ref gives N.
%
%   \code{<code>}
%       Inline code: <code> in \ttfamily on a rounded rectangle (a "pill") in the color "code background", with
%       the text in "code text" if it is defined, else in the surrounding text color. A theme may define the code
%       background (the Joby theme does, for listings too); otherwise it is made from the alternate background
%       colorAltBG, or when there is none from the theme's background (Beamer's normal text background), or from
%       white: the same hue with a quarter of the saturation, a step darker, or lighter if the base is dark.
%       The line may break at a space, where a lower case letter or digit is followed by a capital, and after _ or
%       ::, without a hyphen; the pill is then closed at the end of the line and opened again on the next one.
%       The pills hug the ink of the code and are drawn by LuaTeX (common-code.lua), one shape for each line;
%       other engines put the code on a plain rectangle, which does not break.
%       The code is literal: every character prints as it is, \, {, }, $, &, #, ^, _ and ~ included, and commands
%       are not run (\code{\textbf{x}} prints \textbf{x}). Braces must balance. % is literal too, except where
%       \code is in the argument of another command (a frame without [fragile], a glossary title): there TeX has
%       already read the text, and % starts a comment.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{common}[2026/10/18 Helpers shared by the presentations]

\newcounter{attachment}
\renewcommand{\theattachment}{\arabic{attachment}}

\newbox\common@fullpagebox
\newbox\common@headbox
\newdimen\common@margin

\newenvironment{fullpage}[1][0pt]{%
	\ifdefined\pagewidth\else\PackageError{common}{fullpage needs LuaLaTeX}{Compile with lualatex.}\fi
	\common@margin=\dimexpr#1\relax
	\setbox\common@fullpagebox\hbox\bgroup
	% The counter is stepped (with its anchor) inside the page, so a \label in the content refers to this page.
	\refstepcounter{attachment}%
	% Beamer puts the anchor of a \label outside a frame on the next frame; inside the page it belongs here.
	\ifdefined\beamer@inframetrue\beamer@inframetrue\fi
	\ignorespaces
}{%
	\egroup
	\setbox\common@headbox\hbox{\normalfont\large\bfseries Attachment~\theattachment}%
	\dimen@=\dimexpr\wd\common@fullpagebox+2\common@margin\relax
	\dimen@ii=\dimexpr\ht\common@fullpagebox+\dp\common@fullpagebox
		+\ht\common@headbox+\dp\common@headbox+\baselineskip+2\common@margin\relax
	\begingroup
		\pagewidth=\dimen@ \pageheight=\dimen@ii
		% The page content starts at the page's corner: no offsets.
		\hoffset=-1in \voffset=-1in
		\shipout\vbox to \pageheight{%
			\hsize=\pagewidth
			\kern\common@margin
			\moveright\common@margin\box\common@headbox
			\kern\baselineskip
			\moveright\common@margin\hbox{\unhcopy\common@fullpagebox}%
			\vss}%
	\endgroup
	% The page counts as a page of the PDF, so page references and Beamer's page anchors stay consistent.
	\stepcounter{page}%
}

% Cross-references to attachments: \cref reads "attachment N", \Cref "Attachment N" (cleveref, whenever it is loaded).
\newcommand{\common@attachmentnames}{%
	\crefname{attachment}{attachment}{attachments}%
	\Crefname{attachment}{Attachment}{Attachments}%
}
\@ifpackageloaded{cleveref}{\common@attachmentnames}{\AddToHook{package/cleveref/after}{\common@attachmentnames}}

% Inline code.
% The text is cut into chunks at its break points, with a \discretionary between two chunks: an empty one inside
% a word, and at a space one whose no-break text is the space. With LuaTeX the text carries the attribute
% common@codeattr, set to a number of its own that keys its style (height, depth, radius and color), and
% common-code.lua does the rest: the padding, set against the ink, at the ends of the code and as the
% discretionaries' pre-break and post-break text, and after the line breaking one rounded rectangle behind the
% code on each line. Without LuaTeX the code is on a plain \colorbox, which does not break.
\RequirePackage{xcolor}
\ifdefined\directlua
	\newattribute\common@codeattr
	\newattribute\common@codepadattr
	% (Found like a TeX file: Lua's module path need not include TEXINPUTS.)
	\directlua{local f = kpse.find_file("common-code.lua") if f then dofile(f) end}
\fi
\AtBeginDocument{%
	% The base is the alternate background, else the theme's background (Beamer's normal text), else white.
	\@ifundefinedcolor{code background}{%
		\@ifundefinedcolor{colorAltBG}{%
			\colorlet{common@codebase}{white}%
			\ifdefined\usebeamercolor
				{\usebeamercolor{normal text}\@ifundefinedcolor{normal text.bg}{}{\xglobal\colorlet{common@codebase}{normal text.bg}}}%
			\fi
		}{\colorlet{common@codebase}{colorAltBG}}%
		\common@codebackground
	}{}%
	% Bookmarks and other PDF strings get the plain code.
	\ifdefined\pdfstringdefDisableCommands\pdfstringdefDisableCommands{\let\code\@firstofone}\fi
}
\ExplSyntaxOn
\tl_new:N \l__common_code_tl
\tl_new:N \l__common_code_model_tl
\tl_new:N \l__common_code_spec_tl
\tl_new:N \l__common_code_rgb_tl
\int_new:N \g__common_code_int
\cs_new_protected:Npn \__common_code_break: { \tex_discretionary:D { } { } { } }
\cs_new_protected:Npn \__common_code_space: { \tex_discretionary:D { } { } { \tex_kern:D \fontdimen 2 \font } }
% The code background from the base: its hue, a quarter of its saturation, and a step darker (a step lighter if
% the base is dark), like the Joby theme's.
\cs_new_protected:Npn \common@codebackground
  {
    \extractcolorspecs { common@codebase } \l__common_code_model_tl \l__common_code_spec_tl
    \convertcolorspec \l__common_code_model_tl \l__common_code_spec_tl { hsb } \l__common_code_rgb_tl
    \use:e
      {
        \exp_not:N \definecolor { code~background } { hsb }
          {
            \clist_item:Nn \l__common_code_rgb_tl { 1 } ,
            \fp_eval:n { 0.25 * \clist_item:Nn \l__common_code_rgb_tl { 2 } } ,
            \fp_eval:n
              {
                \fp_compare:nNnTF { \clist_item:Nn \l__common_code_rgb_tl { 3 } } < { 0.5 }
                  { 0.1 + 0.9 * } { 0.9 * } \clist_item:Nn \l__common_code_rgb_tl { 3 }
              }
          }
      }
  }
% \code reads its argument with the special characters made printable (except the braces, which delimit it), so
% that it is literal where it has not been read yet. Where it has (in an argument), it is turned into a string:
% the characters are then printable all the same, but control words come with a space after them, which is taken
% out again unless a letter follows (a space after a control word was not typed, or TeX would have dropped it).
\NewDocumentCommand \code { }
  {
    \mode_leave_vertical:
    \group_begin:
      \clist_map_inline:nn { 92, 36, 38, 35, 94, 95, 37, 126 } { \char_set_catcode_other:n {##1} }
      \__common_code_read:n
  }
\cs_new_protected:Npn \__common_code_read:n #1
  {
    \group_end:
    \__common_code:n {#1}
  }
\cs_new_protected:Npn \__common_code_unspace:
  {
    \regex_replace_all:nnNT { (\\[A-Za-z@]+)\ ([^A-Za-z@]) } { \1\2 } \l__common_code_tl
      { \__common_code_unspace: }
  }
\cs_new_protected:Npn \__common_code:n #1
  {
    \group_begin:
      \tl_set:Nn \l__common_code_tl {#1}
      \regex_replace_all:nnN { \cP\# } { \cO\# } \l__common_code_tl
      \tl_set:Ne \l__common_code_tl { \tl_to_str:N \l__common_code_tl }
      \__common_code_unspace:
      \tl_trim_spaces:N \l__common_code_tl
      \regex_replace_all:nnN { ([a-z0-9])([A-Z]) } { \1 \c{__common_code_break:} \2 } \l__common_code_tl
      \regex_replace_all:nnN { (_|::) } { \1 \c{__common_code_break:} } \l__common_code_tl
      \regex_replace_all:nnN { \s+ } { \c{__common_code_space:} } \l__common_code_tl
      \ttfamily
      \sys_if_engine_luatex:TF
        {
          \int_gincr:N \g__common_code_int
          \extractcolorspecs { code~background } \l__common_code_model_tl \l__common_code_spec_tl
          \convertcolorspec \l__common_code_model_tl \l__common_code_spec_tl { rgb } \l__common_code_rgb_tl
          \tl_replace_all:Nnn \l__common_code_rgb_tl { , } { ~ }
          % The pill is as tall as a parenthesis, the tallest and deepest common glyph, plus 0.1em, and its ends
          % are rounded with a radius of 0.12em, which is also the padding beside the ink.
          \lua_now:e
            {
              commoncode.style
                (
                  \int_use:N \g__common_code_int ,
                  \dim_to_decimal_in_sp:n { \fontcharht \font `( + 0.1em } ,
                  \dim_to_decimal_in_sp:n { \fontchardp \font `( + 0.1em } ,
                  \dim_to_decimal_in_sp:n { 0.12em } ,
                  "\l__common_code_rgb_tl"
                )
            }
          \common@codeattr = \g__common_code_int
          \@ifundefinedcolor { code~text } { } { \color { code~text } }
          \tl_use:N \l__common_code_tl
        }
        {
          \dim_set:Nn \fboxsep { 0.1em }
          \colorbox { code~background }
            { \@ifundefinedcolor { code~text } { } { \color { code~text } } \tl_use:N \l__common_code_tl }
        }
    \group_end:
  }
\ExplSyntaxOff

\endinput
