% betterlistings.sty
%
% Code in slides and documents: a look for code blocks (a listings style, and minted's settings), both opt-in,
% and inline code. Loads listings, tcolorbox and xcolor. Works with any class; with Beamer, captions use its
% caption font and the code its normal text color.
%
%   Code blocks: the listings style betterlisting
%       Opt-in: \begin{lstlisting}[style=betterlisting] ... and \lstinputlisting[style=betterlisting]{<file>},
%       or \lstset{style=betterlisting} for all listings; listings without it are plain listings, as without
%       this package (betterlisting=false turns it off again for one). A block in the style is a box with
%       rounded corners on the color "code background", with a hairline border in "code frame"; the code is in
%       \ttfamily at \betterlistingssize, highlighted (bold keywords in "code keyword", strings in "code
%       string", comments in "code comment"), with line numbers in "code number", and long lines break with an
%       arrow. The language comes from the file's extension (file=, or the input file's name; C++, Python,
%       Java, bash, Lua, LaTeX and others), else \betterlistingsdefaultlanguage (C++); language= overrides it.
%       caption= and title= are a caption above the box (below it with captionpos=b), numbered like listings'
%       own ("Listing 1: ..."), with label= and an entry in the list of listings.
%       In Beamer, a block longer than a slide is split into boxes of whole lines that fit a slide, with the
%       line numbers going on, which an allowframebreaks frame puts on consecutive slides (a box cannot break
%       across slides). splitlines=<n> sets the most lines in a box (0: never split). Boxes break across pages
%       by themselves elsewhere.
%   file=<path>
%       A key of the style: the block gets a header on "code header" with the language, in bold, and <path> in
%       \ttfamily, which wraps after / _ . and - (\begin{lstlisting}[style=betterlisting, file=src/main.cpp]).
%       A block with language= gets the header too, with the language only.
%   \betterlistingssize
%       The font size of code blocks: empty (the surrounding size) unless redefined (the Joby theme makes it
%       \tiny).
%   \betterlistingsminted
%       minted blocks get the colors, frame and size of the style (opt-in as well).
%   \code{<code>}
%       Inline code: <code> in \ttfamily on a rounded rectangle (a "pill") in "code background", with the text in
%       "code text" if it is defined, else in the surrounding text color. The line may break at a space, where a
%       lower case letter or digit is followed by a capital, and after _ or ::, without a hyphen; the pill is
%       then closed at the end of the line and opened again on the next one. The pills hug the ink of the code
%       and are drawn by LuaTeX (betterlistings.lua), one shape for each line; other engines put the code on a
%       plain rectangle, which does not break.
%       The code is literal: every character prints as it is, \, {, }, $, &, #, ^, _ and ~ included, and commands
%       are not run (\code{\textbf{x}} prints \textbf{x}). Braces must balance. % is literal too, except where
%       \code is in the argument of another command (a frame without [fragile], a glossary title): there TeX has
%       already read the text, and % starts a comment.
%   Colors
%       A document or theme may define any of them; otherwise "code background" is made from the alternate
%       background colorAltBG, or when there is none from the theme's background (Beamer's normal text
%       background), or from white: the same hue with a quarter of the saturation, a step darker, or a step
%       lighter if it is dark. "code header" is a step further, and "code frame" is colorAccent, or a step
%       further again. The highlighting colors are mixed with the text color ("code text", Beamer's normal text
%       color or black), so they read on light and dark backgrounds.
%
% With cleveref's hyperref support on (as the Joby theme has it), cleveref's listings hooks make
% \cref@currentprefix expand to itself, and the first listing loops forever; this package sets the listings'
% label with the prefix expanded.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{betterlistings}[2026/10/20 Code blocks and inline code]

\RequirePackage{xcolor}
\RequirePackage{listings}

% --- Colors -----------------------------------------------------------------------------------------------
\ExplSyntaxOn
\tl_new:N \l__betterlistings_model_tl
\tl_new:N \l__betterlistings_spec_tl
\tl_new:N \l__betterlistings_hsb_tl
% Defines color #2 as a step from color #1: its hue, its saturation times #3, and a step darker, or lighter if #1
% is dark.
\cs_new_protected:Npn \__betterlistings_step:nnn #1#2#3
  {
    \extractcolorspecs {#1} \l__betterlistings_model_tl \l__betterlistings_spec_tl
    \convertcolorspec \l__betterlistings_model_tl \l__betterlistings_spec_tl { hsb } \l__betterlistings_hsb_tl
    \tl_set:Ne \l__betterlistings_hsb_tl
      {
        \clist_item:Nn \l__betterlistings_hsb_tl { 1 } ,
        \fp_eval:n { #3 * \clist_item:Nn \l__betterlistings_hsb_tl { 2 } } ,
        \fp_eval:n
          {
            \fp_compare:nNnTF { \clist_item:Nn \l__betterlistings_hsb_tl { 3 } } < { 0.5 }
              { 0.1 + 0.9 * } { 0.9 * } \clist_item:Nn \l__betterlistings_hsb_tl { 3 }
          }
      }
    % Defined in rgb: TikZ (tcolorbox) does not take hsb.
    \convertcolorspec { hsb } \l__betterlistings_hsb_tl { rgb } \l__betterlistings_spec_tl
    \definecolor {#2} { rgb } { \l__betterlistings_spec_tl }
  }
\cs_new_protected:Npn \__betterlistings_colors:
  {
    \@ifundefinedcolor { code~background }
      {
        \@ifundefinedcolor { colorAltBG }
          {
            \colorlet { betterlistings@base } { white }
            \cs_if_exist:NT \usebeamercolor
              {
                \group_begin:
                  \usebeamercolor { normal~text }
                  \@ifundefinedcolor { normal~text.bg } { }
                    { \xglobal \colorlet { betterlistings@base } { normal~text.bg } }
                \group_end:
              }
          }
          { \colorlet { betterlistings@base } { colorAltBG } }
        \__betterlistings_step:nnn { betterlistings@base } { code~background } { 0.25 }
      }
      { }
    \@ifundefinedcolor { code~header }
      { \__betterlistings_step:nnn { code~background } { code~header } { 1 } }
      { }
    \@ifundefinedcolor { code~frame }
      {
        \@ifundefinedcolor { colorAccent }
          { \__betterlistings_step:nnn { code~header } { code~frame } { 1 } }
          { \colorlet { code~frame } { colorAccent } }
      }
      { }
    % The text color, as a color: "code text", else Beamer's normal text color, else black.
    \@ifundefinedcolor { code~text }
      {
        \colorlet { betterlistings@fg } { black }
        \cs_if_exist:NT \usebeamercolor
          {
            \group_begin:
              \usebeamercolor { normal~text }
              \@ifundefinedcolor { normal~text.fg } { }
                { \xglobal \colorlet { betterlistings@fg } { normal~text.fg } }
            \group_end:
          }
      }
      { \colorlet { betterlistings@fg } { code~text } }
    % Highlighting, mixed with the text color so that it reads on light and dark backgrounds alike.
    \@ifundefinedcolor { code~keyword } { \colorlet { code~keyword } { blue!65!betterlistings@fg } } { }
    \@ifundefinedcolor { code~string } { \colorlet { code~string } { green!55!betterlistings@fg } } { }
    \@ifundefinedcolor { code~comment }
      { \colorlet { code~comment } { betterlistings@fg!55!code~background } } { }
    \@ifundefinedcolor { code~number }
      { \colorlet { code~number } { betterlistings@fg!40!code~background } } { }
    \hbox_gset:Nn \betterlistings@arrow { \betterlistingssize \color { code~comment } $ \hookrightarrow $ }
  }
\box_new:N \betterlistings@arrow
% The text color of code: "code text", else Beamer's normal text color, else the surrounding one.
\cs_new_protected:Npn \betterlistings@textcolor
  {
    \@ifundefinedcolor { code~text }
      { \cs_if_exist:NT \usebeamercolor { \usebeamercolor [ fg ] { normal~text } } }
      { \color { code~text } }
  }
\ExplSyntaxOff
\AtBeginDocument{\csname __betterlistings_colors:\endcsname}

% --- Code blocks ------------------------------------------------------------------------------------------
% The look is the listings style betterlisting, which a document opts into, per block (style=betterlisting) or
% for all of them (\lstset{style=betterlisting}); a listing without it is a plain listing, as without this
% package. The style sets the key betterlisting=true, which marks the blocks to box.
% A boxed block is a tcolorbox (rounded, on the code background, with a hairline border in the code frame color)
% with the listing inside it, without a frame or background of its own: listings paints its background line by
% line, which viewers show with seams. Its caption (caption= or title=) is above it, numbered ("Listing 1: ...").
% lstlisting writes its body to a file (tcolorbox's \tcbwritetemp) and shows it the way \lstinputlisting shows a
% file: as boxes if it has the style, else with listings' own \lstinputlisting. Inside a box, tcolorbox calls
% \lstinputlisting itself, which is then listings' own.
% In Beamer a box cannot break across slides (Beamer splits a frame itself, so the box never sees a page break),
% so a block longer than a slide is made of several boxes of whole lines, with the line numbers going on, which
% allowframebreaks puts on consecutive slides.
\RequirePackage{tcolorbox}
\tcbuselibrary{listings,breakable,skins}
\newcommand{\betterlistingssize}{}
\newcommand{\betterlistingsdefaultlanguage}{C++}
% Keys that listings ignores, read once before a block.
\lst@Key{betterlisting}{false}{\def\betterlistings@on{#1}}
\lst@Key{file}{}{\def\betterlistings@file{#1}}
\lst@Key{splitlines}{}{\def\betterlistings@splitlines{#1}}
\lstdefinestyle{betterlisting}{
	betterlisting=true,
	basicstyle=\ttfamily\betterlistingssize\betterlistings@textcolor,
	keywordstyle=\bfseries\color{code keyword},
	stringstyle=\color{code string},
	commentstyle=\color{code comment},
	numbers=left,
	numberstyle=\tiny\color{code number},
	numbersep=1em,
	xleftmargin=1.6em,
	% The box has the padding.
	aboveskip=0pt,
	belowskip=0pt,
	tabsize=4,
	upquote=true,
	breaklines=true,
	% (A color change in postbreak breaks the line, at least in Beamer, whose \color looks ahead for an overlay
	% specification: the arrow is made beforehand, in a box.)
	postbreak=\mbox{\usebox\betterlistings@arrow\space},
	showstringspaces=false,
	columns=fullflexible,
	keepspaces=true,
}
\newif\ifbetterlistings@inbox
\ExplSyntaxOn
\tl_new:N \l__betterlistings_lang_tl
\tl_new:N \l__betterlistings_title_tl
\tl_new:N \l__betterlistings_options_tl
\tl_new:N \l__betterlistings_explicit_tl
\tl_new:N \l__betterlistings_name_tl
\seq_new:N \l__betterlistings_match_seq
\tl_new:N \g__betterlistings_on_tl
\tl_new:N \g__betterlistings_file_tl
\tl_new:N \g__betterlistings_split_tl
\tl_new:N \g__betterlistings_caption_tl
\tl_new:N \g__betterlistings_short_tl
\tl_new:N \g__betterlistings_label_tl
\tl_new:N \g__betterlistings_captionpos_tl
\int_new:N \l__betterlistings_first_int
\int_new:N \l__betterlistings_last_int
\int_new:N \l__betterlistings_number_int
\int_new:N \l__betterlistings_size_int
\int_new:N \l__betterlistings_max_int
\dim_new:N \g__betterlistings_line_dim
\bool_new:N \l__betterlistings_range_bool
% The language for a file name: from its extension, else the default.
\cs_new_protected:Npn \__betterlistings_language:n #1
  {
    \tl_set:Ne \l__betterlistings_lang_tl { \tl_to_str:n {#1} }
    \regex_replace_once:nnNF { \A .* \. ([^./]+) \Z } { \1 } \l__betterlistings_lang_tl
      { \tl_clear:N \l__betterlistings_lang_tl }
    \tl_set:Ne \l__betterlistings_lang_tl
      {
        \str_case_e:nnF { \str_lowercase:f { \l__betterlistings_lang_tl } }
          {
            { c } { C++ } { h } { C++ } { cc } { C++ } { cpp } { C++ } { cxx } { C++ } { hh } { C++ }
            { hpp } { C++ } { hxx } { C++ } { ino } { C++ } { java } { Java } { py } { Python }
            { sh } { bash } { bash } { bash } { lua } { [5.3]Lua } { tex } { [LaTeX]TeX }
            { sty } { [LaTeX]TeX } { cls } { [LaTeX]TeX } { m } { Matlab } { xml } { XML } { html } { HTML }
            { sql } { SQL } { rb } { Ruby } { pl } { Perl }
          }
          { \betterlistingsdefaultlanguage }
      }
  }
% Reads a block's listings options #1, over the current settings: whether it has the style, its file, split and
% caption (caption= or title=, with its short form and label, and where it goes).
\cs_new_protected:Npn \__betterlistings_scan:n #1
  {
    \group_begin:
      \cs_set_eq:NN \lst@caption \c_empty_tl
      \cs_set_eq:NN \lst@@caption \c_empty_tl
      \cs_set_eq:NN \lst@title \c_empty_tl
      \cs_set_eq:NN \lst@label \c_empty_tl
      \def \betterlistings@file { }
      \def \betterlistings@splitlines { }
      \lstset {#1}
      \tl_gset:No \g__betterlistings_on_tl { \betterlistings@on }
      \tl_gset:No \g__betterlistings_file_tl { \betterlistings@file }
      \tl_gset:No \g__betterlistings_split_tl { \betterlistings@splitlines }
      \tl_gset:No \g__betterlistings_label_tl { \lst@label }
      \tl_gset:No \g__betterlistings_captionpos_tl { \lst@captionpos }
      \tl_if_empty:NTF \lst@title
        {
          \token_if_eq_meaning:NNTF \lst@caption \relax
            { \tl_gclear:N \g__betterlistings_caption_tl \tl_gclear:N \g__betterlistings_short_tl }
            {
              \tl_gset:No \g__betterlistings_caption_tl { \lst@caption }
              \tl_gset:No \g__betterlistings_short_tl { \lst@@caption }
            }
        }
        {
          \tl_gset:No \g__betterlistings_caption_tl { \lst@title }
          \tl_gset:No \g__betterlistings_short_tl { \lst@title }
        }
    \group_end:
  }
% Sets up a boxed block from its listings options #1 (and #2, the name of the input file, if any): the options
% for listings (the language first, so that #1 may override it), and the header: the language, in bold, when it
% was set (language=) or the block has a file, then the file= path, which may break after / _ . -.
\cs_new_protected:Npn \__betterlistings_setup:nn #1#2
  {
    \tl_clear:N \l__betterlistings_explicit_tl
    \regex_extract_once:nnNT { language \s* = \s* \{? ([^,\}]*) } { \tl_to_str:n {#1} } \l__betterlistings_match_seq
      { \tl_set:Ne \l__betterlistings_explicit_tl { \seq_item:Nn \l__betterlistings_match_seq { 2 } } }
    \tl_if_empty:NTF \l__betterlistings_explicit_tl
      {
        \tl_if_empty:NTF \g__betterlistings_file_tl
          { \__betterlistings_language:n {#2} }
          { \exp_args:NV \__betterlistings_language:n \g__betterlistings_file_tl }
      }
      { \tl_set_eq:NN \l__betterlistings_lang_tl \l__betterlistings_explicit_tl }
    \tl_set:Ne \l__betterlistings_options_tl
      { language = { \exp_not:V \l__betterlistings_lang_tl } , \exp_not:n {#1} }
    \tl_clear:N \l__betterlistings_title_tl
    \bool_lazy_or:nnT
      { ! \tl_if_empty_p:N \l__betterlistings_explicit_tl } { ! \tl_if_empty_p:N \g__betterlistings_file_tl }
      {
        % The language's name: a dialect like [LaTeX]TeX by its dialect, [5.3]Lua by the language.
        \tl_set:Ne \l__betterlistings_name_tl { \tl_to_str:N \l__betterlistings_lang_tl }
        \regex_replace_once:nnN { \A \[ (.*) \] TeX \Z } { \1 } \l__betterlistings_name_tl
        \regex_replace_once:nnN { \A \[ .* \] } { } \l__betterlistings_name_tl
        \tl_set:Ne \l__betterlistings_title_tl
          { \exp_not:N \textbf { \exp_not:V \l__betterlistings_name_tl } }
      }
    \tl_if_empty:NF \g__betterlistings_file_tl
      {
        \tl_set:Ne \l__betterlistings_name_tl { \tl_to_str:N \g__betterlistings_file_tl }
        \regex_replace_all:nnN { ([/_.\-]) } { \1 \c{allowbreak} } \l__betterlistings_name_tl
        \tl_put_right:Ne \l__betterlistings_title_tl
          { \exp_not:N \quad \exp_not:V \l__betterlistings_name_tl }
      }
  }
% The caption, numbered like listings' own ("Listing 1: ..."), with its label and its entry in the list of
% listings, in the caption font (Beamer's).
\cs_new_protected:Npn \__betterlistings_caption:
  {
    \tl_if_empty:NF \g__betterlistings_caption_tl
      {
        \par
        \refstepcounter { lstlisting }
        \tl_if_empty:NF \g__betterlistings_label_tl { \exp_args:NV \label \g__betterlistings_label_tl }
        \exp_args:Nnne \addcontentsline { \ext@lstlisting } { lstlisting }
          { \exp_not:N \protect \exp_not:N \numberline { \thelstlisting } \exp_not:V \g__betterlistings_short_tl }
        % Beamer numbers a caption from its type (\beamer@makecaption, as its \caption does), other classes
        % from the label (\lst@makecaption, as listings does). Beamer's \caption does not break after it.
        \group_begin:
          \cs_if_exist:NTF \beamer@makecaption
            { \exp_args:NnV \beamer@makecaption { lstlisting } \g__betterlistings_caption_tl \par \nobreak }
            {
              \skip_set:Nn \abovecaptionskip { \smallskipamount }
              \skip_set:Nn \belowcaptionskip { \smallskipamount }
              \exp_args:NNV \lst@makecaption \fnum@lstlisting \g__betterlistings_caption_tl
              \nobreak
            }
        \group_end:
      }
  }
% The lines of the block, \l__betterlistings_first_int to \l__betterlistings_last_int, if they can be told (from
% firstline, lastline or a single linerange, and the number of lines of the file #2, counted in Lua); false if not.
\prg_new_protected_conditional:Npnn \__betterlistings_range:nn #1#2 { T, TF }
  {
    \tl_set:Ne \l__betterlistings_name_tl { \tl_to_str:n {#1} }
    \int_set:Nn \l__betterlistings_first_int { 1 }
    \int_set:Nn \l__betterlistings_last_int { -1 }
    \bool_set_true:N \l_tmpa_bool
    \regex_extract_once:nVNTF { linerange \s* = \s* \{? \s* (\d+) \s* - \s* (\d+) \s* (,|\}|\Z) }
      \l__betterlistings_name_tl \l__betterlistings_match_seq
      {
        \int_set:Nn \l__betterlistings_first_int { \seq_item:Nn \l__betterlistings_match_seq { 2 } }
        \int_set:Nn \l__betterlistings_last_int { \seq_item:Nn \l__betterlistings_match_seq { 3 } }
      }
      {
        % Any other linerange (several ranges, markers) is left to listings, unsplit.
        \regex_match:nVT { linerange } \l__betterlistings_name_tl { \bool_set_false:N \l_tmpa_bool }
        \regex_extract_once:nVNT { firstline \s* = \s* (\d+) } \l__betterlistings_name_tl \l__betterlistings_match_seq
          { \int_set:Nn \l__betterlistings_first_int { \seq_item:Nn \l__betterlistings_match_seq { 2 } } }
        \regex_extract_once:nVNT { lastline \s* = \s* (\d+) } \l__betterlistings_name_tl \l__betterlistings_match_seq
          { \int_set:Nn \l__betterlistings_last_int { \seq_item:Nn \l__betterlistings_match_seq { 2 } } }
      }
    \bool_if:NT \l_tmpa_bool
      {
        \int_compare:nNnT \l__betterlistings_last_int < { 0 }
          {
            \sys_if_engine_luatex:TF
              {
                \int_set:Nn \l__betterlistings_last_int
                  { \lua_now:e { betterlistings.countlines("\lua_escape:e {#2}") } }
              }
              { \bool_set_false:N \l_tmpa_bool }
          }
      }
    \bool_if:NTF \l_tmpa_bool
      { \int_compare:nNnTF \l__betterlistings_last_int < \l__betterlistings_first_int { \prg_return_false: } { \prg_return_true: } }
      { \prg_return_false: }
  }
\cs_generate_variant:Nn \regex_extract_once:nnNTF { nV }
\cs_generate_variant:Nn \regex_extract_once:nnNT { nV }
\cs_generate_variant:Nn \regex_match:nnT { nV }
% Shows a block: listings options #1, #2 the name of the input file (for the language; empty for lstlisting),
% #3 the file to read.
\cs_new_protected:Npn \__betterlistings_show:nnn #1#2#3
  {
    \__betterlistings_scan:n {#1}
    \str_if_eq:VnTF \g__betterlistings_on_tl { true }
      { \__betterlistings_boxes:nnn {#1} {#2} {#3} }
      { \betterlistings@lstinputlisting [#1] {#3} }
  }
\cs_new_protected:Npn \__betterlistings_boxes:nnn #1#2#3
  {
    \__betterlistings_setup:nn {#1} {#2}
    % The most lines in a box: splitlines=, else in Beamer as many as fill 0.8 of the text height (leaving room
    % for the header and caption), at the lines' average height in this block, with the long lines that wrap:
    % the block's lines are typeset once, at the box's width, to measure it. Elsewhere boxes break by themselves.
    \int_zero:N \l__betterlistings_max_int
    \bool_set_false:N \l__betterlistings_range_bool
    \__betterlistings_range:nnT {#1} {#3} { \bool_set_true:N \l__betterlistings_range_bool }
    \tl_if_empty:NTF \g__betterlistings_split_tl
      {
        \bool_lazy_and:nnT { \cs_if_exist_p:N \insertframenumber } { \l__betterlistings_range_bool }
          {
            \hbox_set:Nn \l_tmpa_box
              {
                \vbox:n
                  {
                    \dim_set:Nn \hsize { \linewidth - 2ex - 0.6pt }
                    \dim_set_eq:NN \linewidth \hsize
                    \betterlistings@inboxtrue
                    \use:e
                      {
                        \exp_not:N \betterlistings@lstinputlisting
                          [
                            \exp_not:V \l__betterlistings_options_tl ,
                            linerange =
                              { \int_use:N \l__betterlistings_first_int - \int_use:N \l__betterlistings_last_int } ,
                            nolol , caption = { } , title = { } , label = { }
                          ]
                          { \exp_not:n {#3} }
                      }
                  }
              }
            \dim_gset:Nn \g__betterlistings_line_dim
              {
                ( \box_ht:N \l_tmpa_box + \box_dp:N \l_tmpa_box )
                / ( \l__betterlistings_last_int - \l__betterlistings_first_int + 1 )
              }
            \dim_compare:nNnT \g__betterlistings_line_dim > { 0pt }
              {
                \int_set:Nn \l__betterlistings_max_int
                  {
                    \dim_ratio:nn
                      { 0.8 \textheight - \tl_if_empty:NTF \g__betterlistings_caption_tl { 4 } { 7 } \g__betterlistings_line_dim }
                      { \g__betterlistings_line_dim }
                  }
              }
          }
      }
      { \int_set:Nn \l__betterlistings_max_int { \g__betterlistings_split_tl } }
    \bool_lazy_and:nnTF { \int_compare_p:nNn \l__betterlistings_max_int > { 0 } } { \l__betterlistings_range_bool }
      {
        \int_set:Nn \l__betterlistings_size_int
          { \l__betterlistings_last_int - \l__betterlistings_first_int + 1 }
        \int_compare:nNnTF \l__betterlistings_size_int > \l__betterlistings_max_int
          {
            % Even boxes: as few as hold the lines (n of them), as full as each other.
            \int_set:Nn \l_tmpa_int
              {
                \int_div_truncate:nn
                  { \l__betterlistings_size_int + \l__betterlistings_max_int - 1 } { \l__betterlistings_max_int }
              }
            \int_set:Nn \l__betterlistings_size_int
              { \int_div_truncate:nn { \l__betterlistings_size_int + \l_tmpa_int - 1 } { \l_tmpa_int } }
