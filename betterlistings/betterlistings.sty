% betterlistings.sty
%
% Code in slides and documents, with one look for blocks (listings, and minted when it is loaded) and inline
% code. Loads listings, tcolorbox and xcolor. Works with any class; with Beamer, captions use its caption font
% and the code its normal text color.
%
%   Code blocks
%       \begin{lstlisting}[<options>] ... \end{lstlisting} and \lstinputlisting[<options>]{<file>} (the same
%       commands and listings options as always) are boxes with rounded corners on the color "code background",
%       with a hairline border in "code frame", that break across pages and frames (allowframebreaks). The code
%       is in \ttfamily at \betterlistingssize, highlighted (bold keywords in "code keyword", strings in "code
%       string", comments in "code comment"), with line numbers in "code number", and long lines break with an
%       arrow. The language comes from the file's extension (file=, or the input file's name; C++, Python,
%       Java, bash, Lua, LaTeX and others), else \betterlistingsdefaultlanguage (C++); language= overrides it.
%       Captions (caption=) are kept, in the box.
%   file=<path>
%       A listings key: the block gets a header on "code header" with the language, in bold, and <path> in
%       \ttfamily, which wraps after / _ . and - (\begin{lstlisting}[file=src/main.cpp] ...,
%       \lstinputlisting[file=src/main.cpp]{listings/main.cpp}). A block with language= gets the header too,
%       with the language only.
%   \betterlistingssize
%       The font size of code blocks: empty (the surrounding size) unless redefined (the Joby theme makes it
%       \tiny).
%   \code{<code>}
%       Inline code: <code> in \ttfamily on a rounded rectangle (a "pill") in "code background", with the text in
%       "code text" if it is defined, else in the surrounding text color. The line may break at a space, where a
%       lower case letter or digit is followed by a capital, and after _ or ::, without a hyphen; the pill is
%       then closed at the end of the line and opened again on the next one. The pills hug the ink of the code
%       and are drawn by LuaTeX (betterlistings.lua), one shape for each line; other engines put the code on a
%       plain rectangle, which does not break.
%       The code is literal: every character prints as it is, \, {, }, $, &, #, ^, _ and ~ included, and commands
%       are not run (\code{\textbf{x}} prints \textbf{x}). Braces must balance. % is literal too, except where
%       \code is in the argument of another command (a frame without [fragile], a glossary title): there TeX has
%       already read the text, and % starts a comment.
%   Colors
%       A document or theme may define any of them; otherwise "code background" is made from the alternate
%       background colorAltBG, or when there is none from the theme's background (Beamer's normal text
%       background), or from white: the same hue with a quarter of the saturation, a step darker, or a step
%       lighter if it is dark. "code header" is a step further, and "code frame" is colorAccent, or a step
%       further again. The highlighting colors are mixed with the text color ("code text", Beamer's normal text
%       color or black), so they read on light and dark backgrounds.
%
% With cleveref's hyperref support on (as the Joby theme has it), cleveref's listings hooks make
% \cref@currentprefix expand to itself, and the first listing loops forever; this package sets the listings'
% label with the prefix expanded.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{betterlistings}[2026/10/20 Code blocks and inline code]

\RequirePackage{xcolor}
\RequirePackage{listings}

% --- Colors -----------------------------------------------------------------------------------------------
\ExplSyntaxOn
\tl_new:N \l__betterlistings_model_tl
\tl_new:N \l__betterlistings_spec_tl
\tl_new:N \l__betterlistings_hsb_tl
% Defines color #2 as a step from color #1: its hue, its saturation times #3, and a step darker, or lighter if #1
% is dark.
\cs_new_protected:Npn \__betterlistings_step:nnn #1#2#3
  {
    \extractcolorspecs {#1} \l__betterlistings_model_tl \l__betterlistings_spec_tl
    \convertcolorspec \l__betterlistings_model_tl \l__betterlistings_spec_tl { hsb } \l__betterlistings_hsb_tl
    \tl_set:Ne \l__betterlistings_hsb_tl
      {
        \clist_item:Nn \l__betterlistings_hsb_tl { 1 } ,
        \fp_eval:n { #3 * \clist_item:Nn \l__betterlistings_hsb_tl { 2 } } ,
        \fp_eval:n
          {
            \fp_compare:nNnTF { \clist_item:Nn \l__betterlistings_hsb_tl { 3 } } < { 0.5 }
              { 0.1 + 0.9 * } { 0.9 * } \clist_item:Nn \l__betterlistings_hsb_tl { 3 }
          }
      }
    % Defined in rgb: TikZ (tcolorbox) does not take hsb.
    \convertcolorspec { hsb } \l__betterlistings_hsb_tl { rgb } \l__betterlistings_spec_tl
    \definecolor {#2} { rgb } { \l__betterlistings_spec_tl }
  }
\cs_new_protected:Npn \__betterlistings_colors:
  {
    \@ifundefinedcolor { code~background }
      {
        \@ifundefinedcolor { colorAltBG }
          {
            \colorlet { betterlistings@base } { white }
            \cs_if_exist:NT \usebeamercolor
              {
                \group_begin:
                  \usebeamercolor { normal~text }
                  \@ifundefinedcolor { normal~text.bg } { }
                    { \xglobal \colorlet { betterlistings@base } { normal~text.bg } }
                \group_end:
              }
          }
          { \colorlet { betterlistings@base } { colorAltBG } }
        \__betterlistings_step:nnn { betterlistings@base } { code~background } { 0.25 }
      }
      { }
    \@ifundefinedcolor { code~header }
      { \__betterlistings_step:nnn { code~background } { code~header } { 1 } }
      { }
    \@ifundefinedcolor { code~frame }
      {
        \@ifundefinedcolor { colorAccent }
          { \__betterlistings_step:nnn { code~header } { code~frame } { 1 } }
          { \colorlet { code~frame } { colorAccent } }
      }
      { }
    % The text color, as a color: "code text", else Beamer's normal text color, else black.
    \@ifundefinedcolor { code~text }
      {
        \colorlet { betterlistings@fg } { black }
        \cs_if_exist:NT \usebeamercolor
          {
            \group_begin:
              \usebeamercolor { normal~text }
              \@ifundefinedcolor { normal~text.fg } { }
                { \xglobal \colorlet { betterlistings@fg } { normal~text.fg } }
            \group_end:
          }
      }
      { \colorlet { betterlistings@fg } { code~text } }
    % Highlighting, mixed with the text color so that it reads on light and dark backgrounds alike.
    \@ifundefinedcolor { code~keyword } { \colorlet { code~keyword } { blue!65!betterlistings@fg } } { }
    \@ifundefinedcolor { code~string } { \colorlet { code~string } { green!55!betterlistings@fg } } { }
    \@ifundefinedcolor { code~comment }
      { \colorlet { code~comment } { betterlistings@fg!55!code~background } } { }
    \@ifundefinedcolor { code~number }
      { \colorlet { code~number } { betterlistings@fg!40!code~background } } { }
    \hbox_gset:Nn \betterlistings@arrow { \betterlistingssize \color { code~comment } $ \hookrightarrow $ }
  }
\box_new:N \betterlistings@arrow
% The text color of code: "code text", else Beamer's normal text color, else the surrounding one.
\cs_new_protected:Npn \betterlistings@textcolor
  {
    \@ifundefinedcolor { code~text }
      { \cs_if_exist:NT \usebeamercolor { \usebeamercolor [ fg ] { normal~text } } }
      { \color { code~text } }
  }
\ExplSyntaxOff
\AtBeginDocument{\csname __betterlistings_colors:\endcsname}

% --- Code blocks ------------------------------------------------------------------------------------------
% A block is a tcolorbox (breakable, rounded, on the code background, with a hairline border in the code frame
% color) with the listing inside it, without a frame or background of its own: listings paints its background
% line by line, which viewers show with seams. lstlisting is redefined as a tcolorbox listing, and
% \lstinputlisting as one too, except inside such a box, where tcolorbox itself calls \lstinputlisting.
\RequirePackage{tcolorbox}
\tcbuselibrary{listings,breakable,skins}
\newcommand{\betterlistingssize}{}
\newcommand{\betterlistingsdefaultlanguage}{C++}
\lstset{
	basicstyle=\ttfamily\betterlistingssize\betterlistings@textcolor,
	keywordstyle=\bfseries\color{code keyword},
	stringstyle=\color{code string},
	commentstyle=\color{code comment},
	numbers=left,
	numberstyle=\tiny\color{code number},
	numbersep=1em,
	xleftmargin=1.6em,
	% The box has the padding.
	aboveskip=0pt,
	belowskip=0pt,
	tabsize=4,
	upquote=true,
	breaklines=true,
	% (A color change in postbreak breaks the line, at least in Beamer, whose \color looks ahead for an overlay
	% specification: the arrow is made beforehand, in a box.)
	postbreak=\mbox{\usebox\betterlistings@arrow\space},
	showstringspaces=false,
	columns=fullflexible,
	keepspaces=true,
}
% listings sets its captions itself, not through Beamer's caption templates, so give them Beamer's caption font.
\@ifclassloaded{beamer}{%
	\let\betterlistings@lstmakecaption\lst@makecaption
	\long\def\lst@makecaption#1#2{{\usebeamerfont{caption}\betterlistings@lstmakecaption{#1}{#2}}}%
}{}

% file=<path>: listings ignores it; the block's options are read once beforehand to find it (and the language).
\lst@Key{file}{}{\gdef\betterlistings@file{#1}}
\newif\ifbetterlistings@inbox
\ExplSyntaxOn
\tl_new:N \l__betterlistings_lang_tl
\tl_new:N \l__betterlistings_title_tl
\tl_new:N \l__betterlistings_options_tl
% The language for a file name: from its extension, else the default.
\cs_new_protected:Npn \__betterlistings_language:n #1
  {
    \tl_set:Ne \l__betterlistings_lang_tl { \tl_to_str:n {#1} }
    \regex_replace_once:nnNF { \A .* \. ([^./]+) \Z } { \1 } \l__betterlistings_lang_tl
      { \tl_clear:N \l__betterlistings_lang_tl }
    \tl_set:Ne \l__betterlistings_lang_tl
      {
        \str_case_e:nnF { \str_lowercase:f { \l__betterlistings_lang_tl } }
          {
            { c } { C++ } { h } { C++ } { cc } { C++ } { cpp } { C++ } { cxx } { C++ } { hh } { C++ }
            { hpp } { C++ } { hxx } { C++ } { ino } { C++ } { java } { Java } { py } { Python }
            { sh } { bash } { bash } { bash } { lua } { [5.3]Lua } { tex } { [LaTeX]TeX }
            { sty } { [LaTeX]TeX } { cls } { [LaTeX]TeX } { m } { Matlab } { xml } { XML } { html } { HTML }
            { sql } { SQL } { rb } { Ruby } { pl } { Perl }
          }
          { \betterlistingsdefaultlanguage }
      }
  }
% Sets up a block from its listings options #1 (and #2, the name of the input file, if any): the options for
% listings (the language first, so that #1 may override it), and the header: the language, in bold, when it was
% set (language=) or the block has a file, then the file= path, which may break after / _ . -.
\tl_new:N \l__betterlistings_explicit_tl
\tl_new:N \l__betterlistings_name_tl
\seq_new:N \l__betterlistings_match_seq
\cs_new_protected:Npn \__betterlistings_setup:nn #1#2
  {
    \gdef \betterlistings@file { }
    \group_begin: \lstset {#1} \group_end:
    % The language given in #1, if any.
    \tl_clear:N \l__betterlistings_explicit_tl
    \regex_extract_once:nnNT { language \s* = \s* \{? ([^,\}]*) } { \tl_to_str:n {#1} } \l__betterlistings_match_seq
      { \tl_set:Ne \l__betterlistings_explicit_tl { \seq_item:Nn \l__betterlistings_match_seq { 2 } } }
    \tl_if_empty:NTF \l__betterlistings_explicit_tl
      {
        \tl_if_empty:NTF \betterlistings@file
          { \__betterlistings_language:n {#2} }
          { \exp_args:No \__betterlistings_language:n { \betterlistings@file } }
      }
      { \tl_set_eq:NN \l__betterlistings_lang_tl \l__betterlistings_explicit_tl }
    \tl_set:Ne \l__betterlistings_options_tl
      { language = { \exp_not:V \l__betterlistings_lang_tl } , \exp_not:n {#1} }
    % The header.
    \tl_clear:N \l__betterlistings_title_tl
    \bool_lazy_or:nnT
      { ! \tl_if_empty_p:N \l__betterlistings_explicit_tl } { ! \tl_if_empty_p:N \betterlistings@file }
      {
        % The language's name: a dialect like [LaTeX]TeX by its dialect, [5.3]Lua by the language.
        \tl_set:Ne \l__betterlistings_name_tl { \tl_to_str:N \l__betterlistings_lang_tl }
        \regex_replace_once:nnN { \A \[ (.*) \] TeX \Z } { \1 } \l__betterlistings_name_tl
        \regex_replace_once:nnN { \A \[ .* \] } { } \l__betterlistings_name_tl
        \tl_set:Ne \l__betterlistings_title_tl
          { \exp_not:N \textbf { \exp_not:V \l__betterlistings_name_tl } }
      }
    \tl_if_empty:NF \betterlistings@file
      {
        \tl_set:Ne \l__betterlistings_name_tl { \tl_to_str:N \betterlistings@file }
        \regex_replace_all:nnN { ([/_.\-]) } { \1 \c{allowbreak} } \l__betterlistings_name_tl
        \tl_put_right:Ne \l__betterlistings_title_tl
          { \exp_not:N \quad \exp_not:V \l__betterlistings_name_tl }
      }
  }
\cs_new_eq:NN \betterlistings@setup \__betterlistings_setup:nn
% The tcolorbox options for the block set up last: its header, if it has one, and its listings options.
\cs_new_protected:Npn \betterlistings@block
  {
    \tl_if_empty:NF \l__betterlistings_title_tl
      { \exp_args:Ne \pgfkeysalso { title = { \exp_not:V \l__betterlistings_title_tl } } }
    \exp_args:Ne \pgfkeysalso { listing~options = { \exp_not:V \l__betterlistings_options_tl } }
  }
\ExplSyntaxOff
\tcbset{
	betterlistings/.style={
		enhanced, breakable, listing only,
		arc=1.2mm, boxrule=0.3pt,
		colback=code background, colframe=code frame, colupper=betterlistings@fg,
		left=1ex, right=1ex, top=0.6ex, bottom=0.6ex,
		before skip=1ex, after skip=1ex,
		listing remove caption=false,
		colbacktitle=code header, coltitle=betterlistings@fg,
		fonttitle=\ttfamily\betterlistingssize, halign title=flush left,
		titlerule=0.3pt, toptitle=0.4ex, bottomtitle=0.4ex, lefttitle=1ex, righttitle=1ex,
		before upper={\betterlistings@inboxtrue},
	},
	betterlistings block/.code={\betterlistings@block},
}
\DeclareTCBListing{lstlisting}{ !O{} }{%
	betterlistings, code={\betterlistings@setup{#1}{}}, betterlistings block,
}
\let\betterlistings@lstinputlisting\lstinputlisting
\RenewDocumentCommand{\lstinputlisting}{ O{} m }{%
	\ifbetterlistings@inbox
		\betterlistings@lstinputlisting[#1]{#2}%
	\else
		\tcbinputlisting{betterlistings, code={\betterlistings@setup{#1}{#2}}, betterlistings block,
			listing file={#2}}%
	\fi
}

% cleveref (with its hyperref support) sets the label of listing lines with \cref@currentprefix unexpanded,
% and its EveryPar hook then defines \cref@currentprefix as itself. Set later, the label has it expanded.
\AddToHook{begindocument/end}{%
	\@ifpackageloaded{cleveref}{%
		\lst@AddToHook{Init}{%
			\edef\cref@currentlabel{[line][\noexpand\arabic{lstnumber}][%
				\ifdefined\cref@currentprefix\cref@currentprefix\fi]\noexpand\thelstnumber}}%
	}{}%
}

% minted blocks get the same look, whenever minted is loaded.
\newcommand{\betterlistings@minted}{%
	\setminted{
		fontsize=\betterlistingssize,
		bgcolor=code background,
		frame=single,
		framerule=0.3pt,
		rulecolor=code frame,
		framesep=1ex,
		breaklines=true,
	}%
}
\@ifpackageloaded{minted}{\betterlistings@minted}{\AddToHook{package/minted/after}{\betterlistings@minted}}

% --- Inline code ------------------------------------------------------------------------------------------
% The text is cut into chunks at its break points, with a \discretionary between two chunks: an empty one inside
% a word, and at a space one whose no-break text is the space. With LuaTeX the text carries the attribute
% betterlistings@codeattr, set to a number of its own that keys its style (height, depth, radius and color),
% and betterlistings.lua does the rest: the padding, set against the ink, at the ends of the code and as the
% discretionaries' pre-break and post-break text, and after the line breaking one rounded rectangle behind the
% code on each line. Without LuaTeX the code is on a plain \colorbox, which does not break.
\ifdefined\directlua
	\newattribute\betterlistings@codeattr
	\newattribute\betterlistings@codepadattr
	% (Found like a TeX file: Lua's module path need not include TEXINPUTS.)
	\directlua{local f = kpse.find_file("betterlistings.lua") if f then dofile(f) end}
\fi
% Bookmarks and other PDF strings get the plain code.
\AtBeginDocument{%
	\ifdefined\pdfstringdefDisableCommands\pdfstringdefDisableCommands{\let\code\@firstofone}\fi
}
\ExplSyntaxOn
\tl_new:N \l__betterlistings_code_tl
\tl_new:N \l__betterlistings_rgb_tl
\int_new:N \g__betterlistings_code_int
\cs_new_protected:Npn \__betterlistings_break: { \tex_discretionary:D { } { } { } }
\cs_new_protected:Npn \__betterlistings_space: { \tex_discretionary:D { } { } { \tex_kern:D \fontdimen 2 \font } }
% \code reads its argument with the special characters made printable (except the braces, which delimit it), so
% that it is literal where it has not been read yet. Where it has (in an argument), it is turned into a string:
% the characters are then printable all the same, but control words come with a space after them, which is taken
% out again unless a letter follows (a space after a control word was not typed, or TeX would have dropped it).
\NewDocumentCommand \code { }
  {
    \mode_leave_vertical:
    \group_begin:
      \clist_map_inline:nn { 92, 36, 38, 35, 94, 95, 37, 126 } { \char_set_catcode_other:n {##1} }
      \__betterlistings_read:n
  }
\cs_new_protected:Npn \__betterlistings_read:n #1
  {
    \group_end:
    \__betterlistings_code:n {#1}
  }
\cs_new_protected:Npn \__betterlistings_unspace:
  {
    \regex_replace_all:nnNT { (\\[A-Za-z@]+)\ ([^A-Za-z@]) } { \1\2 } \l__betterlistings_code_tl
      { \__betterlistings_unspace: }
  }
\cs_new_protected:Npn \__betterlistings_code:n #1
  {
    \group_begin:
      \tl_set:Nn \l__betterlistings_code_tl {#1}
      \regex_replace_all:nnN { \cP\# } { \cO\# } \l__betterlistings_code_tl
      \tl_set:Ne \l__betterlistings_code_tl { \tl_to_str:N \l__betterlistings_code_tl }
      \__betterlistings_unspace:
      \tl_trim_spaces:N \l__betterlistings_code_tl
      \regex_replace_all:nnN { ([a-z0-9])([A-Z]) } { \1 \c{__betterlistings_break:} \2 } \l__betterlistings_code_tl
      \regex_replace_all:nnN { (_|::) } { \1 \c{__betterlistings_break:} } \l__betterlistings_code_tl
      \regex_replace_all:nnN { \s+ } { \c{__betterlistings_space:} } \l__betterlistings_code_tl
      \ttfamily
      \sys_if_engine_luatex:TF
        {
          \int_gincr:N \g__betterlistings_code_int
          \extractcolorspecs { code~background } \l__betterlistings_model_tl \l__betterlistings_spec_tl
          \convertcolorspec \l__betterlistings_model_tl \l__betterlistings_spec_tl { rgb } \l__betterlistings_rgb_tl
          \tl_replace_all:Nnn \l__betterlistings_rgb_tl { , } { ~ }
          % The pill is as tall as a parenthesis, the tallest and deepest common glyph, plus 0.1em, and its ends
          % are rounded with a radius of 0.12em, which is also the padding beside the ink.
          \lua_now:e
            {
              betterlistings.style
                (
                  \int_use:N \g__betterlistings_code_int ,
                  \dim_to_decimal_in_sp:n { \fontcharht \font `( + 0.1em } ,
                  \dim_to_decimal_in_sp:n { \fontchardp \font `( + 0.1em } ,
                  \dim_to_decimal_in_sp:n { 0.12em } ,
                  "\l__betterlistings_rgb_tl"
                )
            }
          \betterlistings@codeattr = \g__betterlistings_code_int
          \@ifundefinedcolor { code~text } { } { \color { code~text } }
          \tl_use:N \l__betterlistings_code_tl
        }
        {
          \dim_set:Nn \fboxsep { 0.1em }
          \colorbox { code~background }
            { \@ifundefinedcolor { code~text } { } { \color { code~text } } \tl_use:N \l__betterlistings_code_tl }
        }
    \group_end:
  }
\ExplSyntaxOff

\endinput
