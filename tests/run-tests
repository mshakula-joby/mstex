#!/bin/bash
# Builds every test document with latexmk (LuaLaTeX) and checks the results.
# Usage: ./run-tests [name-filter]     e.g. ./run-tests joby-palette
# Output goes to build/. Exit status is the number of failed tests.

cd "$(dirname "$(realpath "$0")")" || exit 1
TESTS=$PWD
export MSTEX_ROOT=$(realpath ..)
FILTER=${1:-}

# Fixture so revision-number sees a clean tree tagged v1.2.3 (gitinfo2 reads .git/gitHeadInfo.gin
# from the working directory).
FIXTURE=$TESTS/build/fixture
mkdir -p "$FIXTURE/.git"
cat > "$FIXTURE/.git/gitHeadInfo.gin" <<'GIN'
\usepackage[
    shash={abc1234},
    lhash={abc1234abc1234abc1234abc1234abc1234abc1},
    authname={Test Author},
    authemail={test@example.com},
    authsdate={2026-01-02},
    authidate={2026-01-02 03:04:05 -0700},
    authudate={1767323045},
    commname={Test Author},
    commemail={test@example.com},
    commsdate={2026-01-02},
    commidate={2026-01-02 03:04:05 -0700},
    commudate={1767323045},
    refnames={},
    firsttagdescribe={v1.2.3},
    reltag={v1.2.3-0-gabc1234}
]{gitexinfo}
GIN

failures=0

# build <name> [fixture]: returns 0 if the document compiled without errors.
build() {
	local name=$1 fixture=$2 outdir=$TESTS/build
	if [ -n "$fixture" ]; then
		outdir=$FIXTURE/out
		(cd "$FIXTURE" && latexmk -silent -r "$TESTS/.latexmkrc" -outdir="$outdir" "$TESTS/$name.tex" >"$outdir.log" 2>&1)
	else
		(latexmk -silent -r "$TESTS/.latexmkrc" "$TESTS/$name.tex" >"$TESTS/build/$name.latexmk.log" 2>&1)
	fi
	[ -f "$outdir/$name.pdf" ] && ! grep -q '^!\|^[^ ]*:[0-9]*: ' "$outdir/$name.log"
}

text_of() {  # text_of <name> [fixture]
	if [ -n "$2" ]; then pdftotext "$FIXTURE/out/$1.pdf" - 2>/dev/null; else pdftotext "$TESTS/build/$1.pdf" - 2>/dev/null; fi
}

# NOTE: the discardcontent environment is only checked to compile; it does not currently discard its body.

# check <description> <condition-exit-status>
pass() { echo "  ok   $1"; }
fail() { echo "  FAIL $1"; failures=$((failures + 1)); }
expect_text()    { text_of "$2" "$3" | grep -qF -- "$1" && pass "$2 contains '$1'" || fail "$2 contains '$1'"; }
expect_no_text() { text_of "$2" "$3" | grep -qF -- "$1" && fail "$2 lacks '$1'" || pass "$2 lacks '$1'"; }

mkdir -p build
for f in *.tex; do
	name=${f%.tex}
	[ "$name" = joby-body ] && continue
	[[ -n $FILTER && $name != *$FILTER* ]] && continue
	echo "$name"

	fixture=
	case $name in revision-number|joby-revision-*) fixture=1 ;; esac

	if [ "$name" = joby-palette-invalid ]; then
		build "$name" "" && fail "$name fails to compile" || {
			grep -q "Unknown palette" "build/$name.log" && pass "$name reports 'Unknown palette'" || fail "$name reports 'Unknown palette'"
		}
		continue
	fi

	if build "$name" $fixture; then pass "$name compiles"; else fail "$name compiles"; continue; fi

	case $name in
		joby-palette-*)
			expect_text "Joby Theme Test" "$name"
			# The title page has no footer.
			pdftotext -f 1 -l 1 "build/$name.pdf" - | grep -q "JOBY AVIATION" && fail "$name title page has no footer" || pass "$name title page has no footer"
			# Dark palettes have a dark background, the others a light one.
			pdftoppm -r 20 -f 1 -l 1 -png "build/$name.pdf" "build/$name-bg"
			dark=; label=light
			[[ $name == *-dark || $name == joby-palette-dark ]] && { dark=1; label=dark; }
			python3 -I - "$dark" "build/$name-bg"-*.png <<'PY' && pass "$name background is $label" || fail "$name background is $label"
import sys
from PIL import Image
r, g, b = Image.open(sys.argv[2]).convert("RGB").getpixel((3, 30))
is_dark = (r + g + b) / 3 < 100
sys.exit(0 if is_dark == bool(sys.argv[1]) else 1)
PY
			;;
		joby-toc)
			p2=$(pdftotext -f 2 -l 2 "build/$name.pdf" -)
			for n in i 1 3 6; do grep -qx "$n" <<<"$p2" && pass "$name outline page shows '$n'" || fail "$name outline page shows '$n'"; done ;;
		joby-proprietary)
			expect_text "is Joby Aviation Proprietary." "$name"
			expect_text "authorization from Joby Aviation." "$name"
			expect_text "PROPRIETARY INFORMATION. DO NOT DISTRIBUTE." "$name"
			expect_text "JOBY AVIATION" "$name" ;;
		joby-appendix)
			expect_text "A. Bibliography" "$name"; expect_text "B. Lists of Figures and Tables" "$name"; expect_text "D. Glossary" "$name"; expect_text "C. Explicit styles" "$name"
			expect_text "Lamport" "$name"; expect_no_text "knuth1984" "$name"
			expect_text "A first figure" "$name"; expect_text "A first table" "$name"
			expect_text "Flight Control Computer" "$name"
			# Slide numbers continue into the appendix instead of restarting (appendixnumberbeamer is loaded).
			footer_number() { for pg in $(seq 1 30); do pdftotext -f $pg -l $pg "build/$name.pdf" - 2>/dev/null | grep -q "^$1" && { pdftotext -f $pg -l $pg "build/$name.pdf" - | grep -E '^[0-9]+$' | tail -1; return; }; done; }
			main_n=$(footer_number "Content"); app_n=$(footer_number "A. Bibliography")
			[ -n "$main_n" ] && [ -n "$app_n" ] && [ "$app_n" -gt "$main_n" ] && pass "$name numbering continues in the appendix ($main_n -> $app_n)" || fail "$name numbering continues in the appendix ($main_n -> $app_n)"
			# Explicit frame styles override the appendix default: the [standout] frame is not a standin slide.
			for pg in $(seq 1 30); do pdftotext -f $pg -l $pg "build/$name.pdf" - 2>/dev/null | grep -q "^Standout in the appendix" && break; done
			pdftoppm -r 20 -f $pg -l $pg -png "build/$name.pdf" "build/$name-standout"
			python3 -I - "build/$name-standout"-*.png <<'PY' && pass "$name explicit [standout] overrides the appendix style" || fail "$name explicit [standout] overrides the appendix style"
import sys
from PIL import Image
r, g, b = Image.open(sys.argv[1]).convert("RGB").getpixel((60, 45))
sys.exit(0 if b - r > 80 else 1)  # blue standout background
PY
			# The appendix is not in the outline (page 2), and its slides use standin (no title bar).
			pdftotext -f 2 -l 2 "build/$name.pdf" - | grep -q "Bibliography\|Glossary" && fail "$name outline omits the appendix" || pass "$name outline omits the appendix"
			for pg in $(seq 1 20); do pdftotext -f $pg -l $pg "build/$name.pdf" - 2>/dev/null | grep -q "^References" && break; done
			pdftoppm -r 20 -f $pg -l $pg -png "build/$name.pdf" "build/$name-standin"
			python3 -I - "build/$name-standin"-*.png <<'PY' && pass "$name appendix slide has no title bar" || fail "$name appendix slide has no title bar"
import sys
from PIL import Image
r, g, b = Image.open(sys.argv[1]).convert("RGB").getpixel((10, 3))
sys.exit(1 if b - r > 80 else 0)  # blue title bar
PY
			;;
		joby-emph)
			expect_text "emphasized" "$name"
			# \emph and \alert use the same color: compare the two words' pixels at low resolution.
			pdftoppm -r 60 -f 1 -l 1 -png "build/$name.pdf" "build/$name-img"
			python3 -I - "build/$name-img"-*.png <<'PY' && pass "$name \\emph is colored like \\alert" || fail "$name \\emph is colored like \\alert"
import sys
from PIL import Image
im = Image.open(sys.argv[1]).convert("RGB")
w, h = im.size
orange = [p for p in im.crop((0, h // 4, w, 3 * h // 4)).getdata() if p[0] > 200 and 60 < p[1] < 130 and p[2] < 70]
sys.exit(0 if len(orange) > 40 else 1)  # emphasis color (orange on the default palette)
PY
			;;
		joby-institute-empty)
			expect_text "is Test Author Proprietary." "$name"
			expect_text "authorization from Test Author." "$name"
			expect_text "TEST AUTHOR" "$name"
			expect_no_text "JOBY AVIATION" "$name" ;;
		joby-frame-styles)
			# [empty] drops the footer, [plain] keeps it.
			for pg in $(seq 1 20); do pdftotext -f $pg -l $pg "build/$name.pdf" - 2>/dev/null | grep -q "^Empty" && break; done
			pdftotext -f $pg -l $pg "build/$name.pdf" - | grep -q "JOBY AVIATION" && fail "$name [empty] slide has no footer" || pass "$name [empty] slide has no footer"
			for pg in $(seq 1 20); do pdftotext -f $pg -l $pg "build/$name.pdf" - 2>/dev/null | grep -q "^Plain:" && break; done
			pdftotext -f $pg -l $pg "build/$name.pdf" - | grep -q "JOBY AVIATION" && pass "$name [plain] slide keeps the footer" || fail "$name [plain] slide keeps the footer" ;;
		joby-no-options)
			expect_no_text "git:" "$name"
			expect_text "JOBY AVIATION" "$name"
			expect_no_text "PROPRIETARY INFORMATION" "$name"
			expect_no_text "Proprietary." "$name" ;;
		joby-revision-*) expect_text "(git:v1.2.3)" "$name" 1 ;;
		revision-number)
			expect_text "(git:v1.2.3)" "$name" 1
			expect_text "2026-01-02 03:04:05-07:00 (git:v1.2.3)" "$name" 1 ;;
		draft-tools-draft)
			expect_text "a drafting note" "$name"; expect_text "an idea" "$name"; expect_text "some directions" "$name"
			expect_text "[spaced out]" "$name" ;;
		draft-tools-final)
			expect_text "a drafting note" "$name"; expect_no_text "an idea" "$name"; expect_no_text "some directions" "$name"
			expect_text "[spaced out]" "$name" ;;
	esac
done

echo
[ $failures -eq 0 ] && echo "All tests passed." || echo "$failures check(s) failed."
exit $failures
