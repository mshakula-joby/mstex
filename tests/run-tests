import re, sys
pages = open(sys.argv[1]).read().split("<page ")[1:]
for page in pages:
    w = float(re.search(r'width="([\d.]+)"', page).group(1))
    h = float(re.search(r'height="([\d.]+)"', page).group(1))
    for x1, y1, x2, y2, tok in re.findall(r'xMin="([\d.]+)" yMin="([\d.]+)" xMax="([\d.]+)" yMax="([\d.]+)">([^<]*)<', page):
        x1, y1, x2, y2 = map(float, (x1, y1, x2, y2))
        assert 0 <= x1 and x2 <= w, "word %r leaves the slide" % tok
        footer = any(t in tok for t in ("JOBY", "AVIATION", "Math", "10/16", "©")) or y1 > 0.9 * h
        assert footer or y2 < 0.93 * h, "word %r reaches the footer" % tok
