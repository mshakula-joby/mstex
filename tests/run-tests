			corner NORMAL-FRAME logo && pass "$name normal slide has the logo" || fail "$name normal slide has the logo"
			corner STANDIN-FRAME none && pass "$name standin slide has no logo" || fail "$name standin slide has no logo"
			corner STANDOUT-FRAME logo && pass "$name standout slide has the logo" || fail "$name standout slide has the logo"
			corner APPENDIX-FRAME none && pass "$name appendix slide has no logo" || fail "$name appendix slide has no logo"
			;;
