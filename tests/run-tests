			expect_text "CAPTION-ONE" "$name"; expect_text "CAPTION-TWO" "$name"; expect_text "TEXT-BESIDE" "$name"; expect_text "LABEL-RIGHT" "$name"
			expect_text "Figure 1:" "$name"
			pdftotext -bbox "build/$name.pdf" "build/$name.bbox.html"
			python3 -I - "build/$name.bbox.html" "build/$name.pdf" <<'PY' && pass "$name text and captions are ordered, on the page and clear of the footer" || fail "$name text and captions are ordered, on the page and clear of the footer"
import re, sys
html = open(sys.argv[1]).read()
pages = html.split("<page ")[1:]
def words(page):
    h = float(re.search(r'height="([\d.]+)"', page).group(1))
    return h, [(w, float(y1), float(y2)) for y1, y2, w in re.findall(r'yMin="([\d.]+)" xMax="[\d.]+" yMax="([\d.]+)">([^<]*)<', page)]
def find(page_words, token):
    return [(y1, y2) for w, y1, y2 in page_words if token in w][0]
h, p1 = words(pages[0])
above, cap, below = find(p1, "TEXT-ABOVE"), find(p1, "CAPTION-ONE"), find(p1, "TEXT-BELOW")
assert above[0] < cap[0] < below[0], "order on slide 1"
for page in pages:
    h, ws = words(page)
    body = [w for w in ws if not any(t in w[0] for t in ("JOBY", "AVIATION", "Images", "10/16", "©")) and w[1] < 0.9 * h]
    assert body, "no body text"
    # nothing of the body (captions and text) may reach into the footer band
    assert max(w[2] for w in body) < 0.93 * h, "body reaches the footer"
