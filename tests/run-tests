			fi
			;;
		joby-standout-dark)
			expect_text "STANDOUT-NO-BODY" "$name"
			pdftoppm -r 40 -f 1 -l 1 -png "build/$name.pdf" "build/$name-img"
			python3 -I - "build/$name-img"-*.png <<'PY' && pass "$name title is light on the dark standout slide" || fail "$name title is light on the dark standout slide"
