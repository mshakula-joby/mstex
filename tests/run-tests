import sys, colorsys
from PIL import Image
im = Image.open(sys.argv[1]).convert("RGB")
w, h = im.size
def step(rgb, f):  # a step from a color: its hue, its saturation times f, a step darker (lighter if dark)
    hh, s, v = colorsys.rgb_to_hsv(*(c / 255 for c in rgb))
    v = 0.1 + 0.9 * v if v < 0.5 else 0.9 * v
    return tuple(round(255 * c) for c in colorsys.hsv_to_rgb(hh, s * f, v))
code = step((0xF5, 0xF4, 0xDF), 0.25)
header = step(code, 1)
near = lambda p, c: sum(abs(a - b) for a, b in zip(p, c)) < 6
def boxes(c, x0, x1):  # runs of rows with that color in columns x0..x1, and the color's extent in each
    rows = [y for y in range(h) if sum(near(im.getpixel((x, y)), c) for x in range(x0, x1, 4)) > 20]
    out, cur = [], [rows[0]]
    for y in rows[1:]:
        if y - cur[-1] > 1: out.append(cur); cur = [y]
        else: cur.append(y)
    out.append(cur)
    res = []
    for b in out:
        if len(b) < 5: continue  # a row of the shadow's gradient that passes through the color
        y = b[len(b) // 2]
        xs = [x for x in range(x0, x1) if near(im.getpixel((x, y)), c)]
        res.append((b[0], b[-1], min(xs), max(xs)))
    return res
for x0, x1, nheads in ((0, w // 2, 1), (w // 2, w, 2)):
    heads, blocks = boxes(header, x0, x1), boxes(code, x0, x1)
    assert len(heads) == nheads and len(blocks) == 2, (heads, blocks)
    for ht, hb, hl, hr in heads:
        below = [b for b in blocks if 0 <= b[0] - hb <= 30]
        assert below, "a block right below the header at %d" % hb
        bt, bb, bl, br = below[0]
        assert abs(hl - bl) <= 3 and abs(hr - br) <= 3, "as wide: %s %s" % ((hl, hr), (bl, br))
