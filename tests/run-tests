import re, sys
html = open(sys.argv[1]).read()
H = float(re.search(r'height="([\d.]+)"', html).group(1))
words = [(w, float(a), float(b), float(c), float(d)) for a, b, c, d, w in re.findall(r'xMin="([\d.]+)" yMin="([\d.]+)" xMax="([\d.]+)" yMax="([\d.]+)">([^<]*)<', html)]
pdf = open(sys.argv[2], "rb").read().decode("latin1")
links = []
for m in re.finditer(r"/Subtype\s*/Link", pdf):
    blk = pdf[max(0, m.start() - 400): m.start() + 400]
    rect = re.search(r"/Rect\s*\[([^\]]*)\]", blk[blk.rfind("<<", 0, 400):]) or re.search(r"/Rect\s*\[([^\]]*)\]", blk)
    dest = re.search(r"/D\s*\(([^)]*)\)", pdf[m.start(): m.start() + 400])
    if rect and dest and dest.group(1) == "fig:a":
        x1, y1, x2, y2 = map(float, rect.group(1).split())
        links.append((x1, H - y2, x2, H - y1))
def covers(name_word, number_word_index):
    i = [k for k, w in enumerate(words) if w[0] == name_word][0]
    first, last = words[i], words[i + 1]
    return any(l[0] <= first[1] + 1 and l[2] >= last[1] + 3 for l in links)
assert len(links) >= 2, "expected links for \\cref and \\Cref, found %d" % len(links)
assert covers("fig.", 1), "\\cref link does not cover 'fig. 1'"
assert covers("Figure", 1), "\\Cref link does not cover 'Figure 1'"
