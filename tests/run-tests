			p2=$(pdftotext -f 2 -l 2 "build/$name.pdf" -)
			for n in i 1 3 6; do grep -qx "$n" <<<"$p2" && pass "$name outline page shows '$n'" || fail "$name outline page shows '$n'"; done ;;
		joby-proprietary)
			expect_text "is Joby Aviation Proprietary." "$name"
			expect_text "authorization from Joby Aviation." "$name"
			expect_text "PROPRIETARY INFORMATION. DO NOT DISTRIBUTE." "$name"
			expect_text "JOBY AVIATION" "$name" ;;
		joby-appendix)
			expect_text "A. Bibliography" "$name"; expect_text "B. Lists of Figures and Tables" "$name"; expect_text "D. Glossary" "$name"; expect_text "C. Explicit styles" "$name"
			expect_text "Lamport" "$name"; expect_no_text "knuth1984" "$name"
			expect_text "A first figure" "$name"; expect_text "A first table" "$name"
			expect_text "Flight Control Computer" "$name"
			# Slide numbers continue into the appendix instead of restarting (appendixnumberbeamer is loaded).
			footer_number() { for pg in $(seq 1 30); do pdftotext -f $pg -l $pg "build/$name.pdf" - 2>/dev/null | grep -q "^$1" && { pdftotext -f $pg -l $pg "build/$name.pdf" - | grep -E '^[0-9]+$' | tail -1; return; }; done; }
			main_n=$(footer_number "Content"); app_n=$(footer_number "A. Bibliography")
			[ -n "$main_n" ] && [ -n "$app_n" ] && [ "$app_n" -gt "$main_n" ] && pass "$name numbering continues in the appendix ($main_n -> $app_n)" || fail "$name numbering continues in the appendix ($main_n -> $app_n)"
			# Explicit frame styles override the appendix default: the [standout] frame is not a standin slide.
			for pg in $(seq 1 30); do pdftotext -f $pg -l $pg "build/$name.pdf" - 2>/dev/null | grep -q "^Standout in the appendix" && break; done
			pdftoppm -r 20 -f $pg -l $pg -png "build/$name.pdf" "build/$name-standout"
			python3 -I - "build/$name-standout"-*.png <<'PY' && pass "$name explicit [standout] overrides the appendix style" || fail "$name explicit [standout] overrides the appendix style"
