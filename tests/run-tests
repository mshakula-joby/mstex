			pdftotext -f $pg -l $pg "build/$name.pdf" - | grep -q "JOBY AVIATION" && fail "$name [empty] slide has no footer" || pass "$name [empty] slide has no footer"
			for pg in $(seq 1 20); do pdftotext -f $pg -l $pg "build/$name.pdf" - 2>/dev/null | grep -q "^Plain:" && break; done
